# ==========================================
# MolCraft Agent 环境变量配置
# 复制此文件为 .env 并填入你的实际密钥
#   cp .env.example .env
# ==========================================

# ==========================================
# 必填：大语言模型（Agent 的大脑）
# ==========================================
# 选一个方案启用即可（取消注释 3 行，填入真实 key）

# --- 方案 A：DeepSeek（推荐，性价比高）---
# DeepSeek V4 Pro 有 reasoning_content 推理字段支持
# 注册：https://platform.deepseek.com → API Keys → 创建 API key
# 充值：DeepSeek 平台余额（约 ¥30 可跑完整一轮迭代）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-v4-pro

# --- 方案 B：Kimi（Moonshot AI）---
# 注册：https://platform.moonshot.cn → API Keys → 创建 key
# 模型：kimi-k2.6（默认），kimi-k2.5 也可用
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-your-kimi-api-key
# LLM_MODEL=kimi-k2.6

# --- 方案 C：OpenAI ---
# 注册：https://platform.openai.com → API Keys
# 模型推荐：gpt-4o（需有 API 额度）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o

# --- 方案 D：阶跃星辰（Stepfun）---
# 注册：https://platform.stepfun.com → API Keys
# LLM_BASE_URL=https://api.stepfun.com/v1
# LLM_API_KEY=your-stepfun-key
# LLM_MODEL=step-2-16k

# --- 方案 E：智谱 GLM ---
# 注册：https://open.bigmodel.cn → API Keys
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_API_KEY=your-glm-key
# LLM_MODEL=glm-4.6

# --- 方案 F：本地模型（Ollama / vLLM）---
# 需本地部署，例如：
#   ollama run qwen2.5:14b
#   vllm serve Qwen/Qwen2.5-14B-Instruct
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama             # Ollama 接受任意值
# LLM_MODEL=qwen2.5:14b

# ==========================================
# LLM 进阶参数（可选）
# ==========================================
# LLM_MAX_CONTEXT_SIZE=1000000   # 最大上下文 token 数（默认 100000，DeepSeek 支持 1M）
# LLM_PROVIDER_TYPE=openai_legacy # 默认即可，DeepSeek 类需要 legacy

# ==========================================
# 扩散模型 API（可选，推荐）
# ==========================================
# PocketXMol 扩散模型 GPU 服务器地址
# 需先在 GPU 服务器上部署扩散模型服务（详见 docs/diffusion_server.md）
DIFFUSION_API_URL=http://your-gpu-server:8001
# DIFFUSION_TIMEOUT=1800         # 超时秒数（默认 1800=30 分钟）
# DIFFUSION_DEFAULT_N=20         # 每次生成分子数（默认 20）

# ==========================================
# Bohrium LKM 科学知识图谱（可选）
# ==========================================
# 注册获取 access key：
#   1. 访问 https://bohrium.dp.tech → 注册/登录
#   2. 进入工作台 → 个人设置 → API 令牌 → 创建
#   3. 复制生成的 access key
# 功能：搜索科学文献、claims、推理链
# 不配置时 SearchLKM 工具会返回错误提示
# LKM_ACCESS_KEY=your-lkm-access-key

# ==========================================
# 逆合成 API（可选）
# ==========================================
# IBM RXN for Chemistry
# 注册：https://rxn.res.ibm.com → 创建账户 → API Keys
# 不配置时将使用内置的简化反应模板
# RXN_API_KEY=your-rxn-api-key
# USE_RXN_API=false   # 设为 false 可强制禁用 RXN API