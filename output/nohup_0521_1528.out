    26	def smiles_to_pdbqt(smiles: str, output_path: str = None):
    27	    """使用 RDKit + Meeko 将 SMILES 转换为 PDBQT 文件。"""
    28	    mol = Chem.MolFromSmiles(smiles)
    29	    if mol is None:
    30	        return None
    31	
    32	    mol = Chem.AddHs(mol)
    33	    ret = AllChem.EmbedMolecule(mol, randomSeed=42)
    34	    if ret != 0:
    35	        ret = AllChem.EmbedMolecule(mol, AllChem.ETKDGv3())
    36	    if ret != 0:
    37	        return None
    38	    try:
    39	        AllChem.MMFFOptimizeMolecule(mol, maxIters=200)
    40	    except Exception:
    41	        pass
    42	
    43	    preparator = MoleculePreparation()
    44	    setup_list = preparator.prepare(mol)
    45	    if not setup_list:
    46	        return None
    47	
    48	    pdbqt_string = PDBQTWriterLegacy.write_string(setup_list[0])[0]
    49	
    50	    if output_path is None:
    51	        fd, output_path = tempfile.mkstemp(suffix=".pdbqt")
    52	        os.close(fd)
    53	
    54	    with open(output_path, "w") as f:
    55	        f.write(pdbqt_string)
    56	
    57	    return output_path
    58	
    59	
    60	def smiles_to_pdbqt_multi_conformer(smiles: str, n_conformers: int = 5):
    61	    """生成多个 3D 构象并转换为 PDBQT 文件列表（H029）。
    62	
    63	    文献依据:
    64	    - Coscientist (Boiko et al., 2023): 重复实验消除随机偏差
    65	    - GNINA Benchmarking (Molecules, 2025): 构象采样影响对接精度
    66	    - 计算化学基本原则: 构象系综对接优于单构象
    67	
    68	    实现:
    69	    1. RDKit ETKDGv3 生成 N 个构象
    70	    2. MMFF94 优化每个构象
    71	    3. Meeko 转换为 PDBQT
    72	
    73	    Args:
    74	        smiles: 配体 SMILES 字符串
    75	        n_conformers: 目标构象数
    76	
    77	    Returns:
    78	        list[str] | None: PDBQT 文件路径列表，失败返回 None
    79	    """
    80	    mol = Chem.MolFromSmiles(smiles)
    81	    if mol is None:
    82	        return None
    83	
    84	    mol = Chem.AddHs(mol)
    85	
    86	    # 使用 ETKDGv3 生成多个构象
    87	    params = AllChem.ETKDGv3()
    88	    params.randomSeed = 42
    89	    params.numThreads = 0  # 自动
    90	    params.pruneRmsThresh = 0.5  # RMSD 剪枝阈值，保持构象多样性
    91	
    92	    conf_ids = AllChem.EmbedMultipleConfs(mol, numConfs=n_conformers, params=params)
    93	    if not conf_ids:
    94	        # 回退到单构象
    95	        ret = AllChem.EmbedMolecule(mol, params)
    96	        if ret != 0:
    97	            return None
    98	        conf_ids = [0]
    99	
   100	    pdbqt_paths = []
   101	    for conf_id in conf_ids:
   102	        try:
   103	            # 优化当前构象
   104	            AllChem.MMFFOptimizeMolecule(mol, confId=conf_id, maxIters=200)
   105	        except Exception:
   106	            pass
   107	
   108	        # 提取单个构象为独立 Mol 对象
   109	        conf_mol = Chem.Mol(mol, False, conf_id)
   110	
   111	        # 用 Meeko 准备 PDBQT
   112	        preparator = MoleculePreparation()
   113	        try:
   114	            setup_list = preparator.prepare(conf_mol)
   115	            if not setup_list:
   116	                continue
   117	            pdbqt_string = PDBQTWriterLegacy.write_string(setup_list[0])[0]
   118	        except Exception:
   119	            continue
   120	
   121	        fd, output_path = tempfile.mkstemp(suffix=".pdbqt")
   122	        with os.fdopen(fd, "w") as f:
   123	            f.write(pdbqt_string)
   124	        pdbqt_paths.append(output_path)
   125	
   126	    return pdbqt_paths if pdbqt_paths else None
   127	
