   318	        raise
   319	
   320	    # 结构化日志：通过 EventLogger 输出 metrics
   321	    if logger is not None:
   322	        energies = [r["binding_energy"] for r in results if r["binding_energy"] is not None]
   323	        steps = [r.get("syn_steps", 0) for r in results]
   324	        logger.log_metrics(MetricsEvent(
   325	            molecule_count=len(results),
   326	            non_trivial_count=len(results) - trivial_count,
   327	            trivial_count=trivial_count,
   328	            avg_binding_energy=sum(energies) / len(energies) if energies else None,
   329	            min_binding_energy=min(energies) if energies else None,
   330	            avg_syn_steps=sum(steps) / len(steps) if steps else None,
   331	            docking_success_rate=0.0,
   332	        ))
   333	
   334	    # 打印摘要
   335	    log("=" * 60, log_lines)
   336	    log("流程完成", log_lines)
   337	    log(f"最佳结合能: {results[0]['binding_energy']} kcal/mol", log_lines)
   338	    log(f"输出文件: {csv_path}", log_lines)
   339	    log("=" * 60, log_lines)
   340	
   341	    return results
