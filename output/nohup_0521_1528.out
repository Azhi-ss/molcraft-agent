编译通过。验证修改完整性。<system>40 lines read from file starting from line 37.</system>    37	def count_rings(smiles: str) -> int:
    38	    """Count the number of rings in a molecule."""
    39	    from rdkit import Chem
    40	    mol = Chem.MolFromSmiles(smiles)
    41	    if mol is None:
    42	        return 0
    43	    return Chem.rdMolDescriptors.CalcNumRings(mol)
    44	
    45	
    46	def compute_logp_score(logp: float) -> float:
    47	    """Compute LogP reasonableness score (H030).
    48	
    49	    Vina scoring over-rewards hydrophobic (high LogP) molecules due to
    50	    overestimated burial of nonpolar surface area. This function returns a
    51	    penalty factor: 1.0 for drug-like LogP (<=2), linear decay to 0.0 for
    52	    excessively lipophilic molecules (>=5).
    53	
    54	    Literature:
    55	    - Vina Scoring Known Biases: "Hydrophobic overestimation"
    56	    - Lipinski Rule of 5: LogP > 5 alerts for poor absorption
    57	    - Multi-parameter optimization (Kabiri, 2025)
    58	
    59	    Returns:
    60	        float: 0.0 (worst) to 1.0 (best)
    61	    """
    62	    if logp <= 2.0:
    63	        return 1.0
    64	    if logp >= 5.0:
    65	        return 0.0
    66	    # Linear decay: score = 1.0 - (logp - 2.0) / 3.0
    67	    return max(0.0, 1.0 - (logp - 2.0) / 3.0)
    68	
    69	
    70	
