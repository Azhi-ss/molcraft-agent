  1072	            
  1073	            # 如果 combine 产量不足或非 combine 策略，用 mutate 补充
  1074	            if len(batch_mols) < batch_size:
  1075	                seeds = SCAFFOLDS if scaffold is None else [scaffold]
  1076	                while len(batch_mols) < batch_size and attempts < max_attempts:
  1077	                    attempts += 1
