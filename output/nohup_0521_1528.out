  1244	
  1245	def _avg_pairwise_similarity(molecules):
  1246	    """计算分子集合的平均成对 Tanimoto 相似度（H011 辅助）。"""
  1247	    if len(molecules) < 2:
  1248	        return 0.0
  1249	    fps = []
  1250	    for m in molecules:
  1251	        try:
  1252	            mol = Chem.MolFromSmiles(m.get("smiles", ""))
  1253	            fp = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=1024)
  1254	            fps.append(fp)
  1255	        except Exception:
  1256	            fps.append(None)
  1257	
  1258	    sims = []
  1259	    for i in range(len(fps)):
  1260	        for j in range(i + 1, len(fps)):
  1261	            if fps[i] is not None and fps[j] is not None:
  1262	                sims.append(TanimotoSimilarity(fps[i], fps[j]))
  1263	    return sum(sims) / len(sims) if sims else 0.0

