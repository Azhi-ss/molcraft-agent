   302	    os.close(fd)
   303	
   304	    try:
   305	        with open(temp_csv, "w", newline="", encoding="utf-8") as f:
   306	            writer = csv.DictWriter(f, fieldnames=["mol_smiles", "route"])
   307	            writer.writeheader()
   308	            for row in results:
   309	                writer.writerow({"mol_smiles": row["mol_smiles"], "route": row["route"]})
   310	
   311	        # 原子替换：只有完整写入成功后才替换正式文件
   312	        os.replace(temp_csv, csv_path)
   313	        log(f"结果已保存到 {csv_path}", log_lines)
   314	    except Exception as e:
   315	        if os.path.exists(temp_csv):
