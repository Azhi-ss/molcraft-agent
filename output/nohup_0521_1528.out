  1082	                        props = evaluate_molecule(new_smiles)
  1083	                        if passes_filters(props):
  1084	                            batch_mols.append(props)
  1085	        else:
  1086	            # H018: 后续代三种算子 — 变异（60%）/ Crossover（25%）/ BRICS 重组（15%）
  1087	            seed_smiles_list = [s["smiles"] for s in current_seeds]
  1088	            while len(batch_mols) < batch_size and attempts < max_attempts:
  1089	                attempts += 1
  1090	                rand_val = random.random()
  1091	
  1092	                if rand_val < 0.25 and len(seed_smiles_list) >= 2:
  1093	                    # H013+H018: Crossover — 双亲片段交换重组（25%，原 15%）
  1094	                    s1, s2 = random.sample(seed_smiles_list, 2)
