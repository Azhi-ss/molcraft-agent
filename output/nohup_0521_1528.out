   415	def _generate_offspring(seeds, n_offspring_per_seed):
   416	    """从种子分子生成变异后代。
   417	
   418	    利用对接成功的种子作为起点，通过随机变异产生新分子。
   419	    这模拟了进化算法中的"选择+变异"步骤。
   420	    """
   421	    import random
   422	    from evaluator import evaluate_molecule, passes_filters
   423	
   424	    offspring = []
   425	    attempts = 0
   426	    max_attempts = len(seeds) * n_offspring_per_seed * 20
   427	
   428	    while len(offspring) < len(seeds) * n_offspring_per_seed and attempts < max_attempts:
   429	        attempts += 1
   430	        seed = random.choice(seeds)
   431	        seed_smiles = seed.get("smiles", "")
   432	        if not seed_smiles:
   433	            continue
   434	
   435	        # 变异强度：1-4个突变点
   436	        n_mut = random.randint(1, 4)
   437	        new_smiles = random_mutate_smiles(seed_smiles, n_mut)
   438	
   439	        if new_smiles and new_smiles != seed_smiles:
   440	            # 检查是否为单片段（多片段 SMILES 会导致 Meeko 崩溃）
   441	            mol_check = Chem.MolFromSmiles(new_smiles)
   442	            if mol_check is None or len(Chem.GetMolFrags(mol_check)) > 1:
   443	                continue
   444	            props = evaluate_molecule(new_smiles)
   445	            if passes_filters(props):
   446	                offspring.append(props)
   447	    
   448	    return offspring
   449	
   450	
   451	def main():
   452	    parser = argparse.ArgumentParser(description="运行进化迭代版药物研发流程")
   453	    parser.add_argument("--n-generate", type=int, default=50, help="每代生成分子数量 (默认: 50)")
   454	    parser.add_argument("--n-top", type=int, default=10, help="保留 top N 分子 (默认: 10)")
   455	    parser.add_argument("--strategy", choices=["mutate", "combine", "random"], default="mutate",
   456	                        help="生成策略 (默认: mutate)")
   457	    parser.add_argument("--n-generations", type=int, default=2, help="进化代数 (默认: 2)")
   458	    parser.add_argument("--n-offspring", type=int, default=3, help="每个种子的变异体数量 (默认: 3)")
   459	    parser.add_argument("--output-dir", type=str, default="output", help="输出目录")
   460	    parser.add_argument("--no-docking-guidance", action="store_false", dest="use_docking_guidance",
   461	                        help="禁用 H002 对接引导（不推荐，已验证会退化 0.4~0.8 kcal/mol）")
   462	    parser.add_argument("--generator", choices=["mutate", "diffusion", "hybrid"], default="mutate",
   463	                        help="生成器选择: mutate(RDKit变异), diffusion(PocketXMol扩散), hybrid(混合) (默认: mutate)")
   464	    args = parser.parse_args()
   465	
   466	    run_evolutionary_pipeline(
   467	        n_generate=args.n_generate,
   468	        n_top=args.n_top,
   469	        strategy=args.strategy,
   470	        n_generations=args.n_generations,
   471	        n_offspring_per_seed=args.n_offspring,
   472	        output_dir=args.output_dir,
   473	        use_docking_guidance=args.use_docking_guidance,
   474	        generator=args.generator,
   475	    )
   476	
   477	
   478	if __name__ == "__main__":
   479	    main()

