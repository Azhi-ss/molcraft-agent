   253	    energies_all = [c["binding_energy"] for c in scored_candidates if c["binding_energy"] is not None]
   254	    if energies_all:
   255	        e_min, e_max = min(energies_all), max(energies_all)
   256	        if e_max > e_min:
   257	            for c in scored_candidates:
   258	                if c["binding_energy"] is not None:
   259	                    be_norm = (e_max - c["binding_energy"]) / (e_max - e_min)
   260	                else:
   261	                    be_norm = 0.0
   262	                c["composite_score"] = 0.8 * be_norm + 0.2 * c["route_quality"]
   263	        else:
