   277	    # H012+H030 复合评分: 0.75×BE_norm + 0.15×route_quality + 0.10×logp_score
   278	    # H030: LogP penalty counters Vina hydrophobic bias that over-rewards
   279	    # large polycyclic aromatics (LogP>4) which retrosynthesis rules cannot handle.
   280	    energies_all = [c["binding_energy"] for c in scored_candidates if c["binding_energy"] is not None]
   281	    if energies_all:
   282	        e_min, e_max = min(energies_all), max(energies_all)
   283	        if e_max > e_min:
   284	            for c in scored_candidates:
   285	                if c["binding_energy"] is not None:
   286	                    be_norm = (e_max - c["binding_energy"]) / (e_max - e_min)
   287	                else:
   288	                    be_norm = 0.0
   289	                # H030: LogP score penalizes excessively lipophilic molecules
   290	                logp_score = compute_logp_score(c.get("logp", 0.0))
   291	                c["composite_score"] = 0.75 * be_norm + 0.15 * c["route_quality"] + 0.10 * logp_score
   292	        else:
