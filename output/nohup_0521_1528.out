    10	
    11	
    12	# Path to calibration file, relative to project root
    13	CALIBRATION_PATH = Path(__file__).parent.parent / "data" / "calibration.json"
    14	
    15	
    16	# Default calibration values
    17	DEFAULT_CALIBRATION = {
    18	    "version": 1,
    19	    "binding_score": {
    20	        "function": "clipped_linear",
    21	        "params": {"threshold": 0.0, "range": 15.0},
    22	    },
    23	    "sa_score": {
