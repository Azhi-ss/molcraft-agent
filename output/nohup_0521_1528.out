   344	def _generate_diffusion(n_molecules, log_lines):
   345	    """调用 PocketXMol 扩散模型 HTTP API 生成口袋感知分子。
   346	
   347	    Returns:
   348	        list[dict] | None: 生成的分子列表（格式与 generate_molecules 兼容），失败返回 None
   349	    """
   350	    import urllib.request
   351	    import urllib.error
   352	    from src import config as _config
   353	
   354	    api_url = _config.DIFFUSION_API_URL
   355	    if not api_url:
   356	        log("DIFFUSION_API_URL 未配置，跳过扩散模型生成", log_lines)
   357	        return None
   358	
   359	    try:
   360	        pdb_path = _config.TARGET_PDB
   361	        if not os.path.exists(pdb_path):
   362	            log(f"PDB 文件不存在: {pdb_path}", log_lines)
   363	            return None
   364	        pdb_content = open(pdb_path).read()
   365	
   366	        request_body = json.dumps({
   367	            "pdb_content": pdb_content,
   368	            "n_molecules": n_molecules,
   369	            "pocket_center": _config.DOCKING_CENTER,
   370	            "pocket_radius": max(_config.DOCKING_SIZE) / 2.0 if _config.DOCKING_SIZE else 15.0,
   371	        }, ensure_ascii=False).encode("utf-8")
   372	
   373	        url = f"{api_url.rstrip('/')}/generate"
   374	        req = urllib.request.Request(
   375	            url, data=request_body,
   376	            headers={"Content-Type": "application/json"},
   377	            method="POST",
   378	        )
   379	
   380	        log(f"调用扩散模型 API: {url} (n={n_molecules})", log_lines)
   381	        with urllib.request.urlopen(req, timeout=_config.DIFFUSION_TIMEOUT) as resp:
   382	            result = json.loads(resp.read().decode("utf-8"))
   383	
   384	        molecules = result.get("molecules", [])
   385	        gen_time = result.get("generation_time_seconds", 0)
   386	        log(f"扩散模型返回 {len(molecules)} 个分子 (耗时 {gen_time:.0f}s)", log_lines)
   387	
   388	        # 转换为与 generate_molecules 兼容的格式
   389	        converted = []
   390	        for m in molecules:
   391	            smiles = m.get("smiles", "")
   392	            if not smiles:
   393	                continue
   394	            mol = Chem.MolFromSmiles(smiles)
   395	            if mol is None or len(Chem.GetMolFrags(mol)) > 1:
   396	                continue
   397	            converted.append({
   398	                "smiles": smiles,
   399	                "qed": m.get("qed"),
   400	                "mw": m.get("mw"),
   401	                "logp": m.get("logp"),
   402	                "sa_score": m.get("sa_score"),
   403	            })
   404	
   405	        return converted if converted else None
   406	
   407	    except urllib.error.URLError as e:
   408	        log(f"扩散模型 API 连接失败: {e}", log_lines)
   409	        return None
   410	    except Exception as e:
   411	        log(f"扩散模型生成异常: {e}", log_lines)
   412	        return None
   413	
