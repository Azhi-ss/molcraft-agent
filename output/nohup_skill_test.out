   541	def _crossover_mol(mol1, mol2):
   542	    """分子 Crossover 重组算子（H013）：交换两个父代分子的侧链装饰。
   543	
   544	    文献依据:
   545	    - MOOSE-Chem (Yang et al., 2025): "Evolutionary operators include crossover
   546	      between parent molecules, fragment swapping, and scaffold hopping"
   547	    - MolLEO (Wang et al., 2024b): LLM 驱动的重组操作
   548	    - Deep Lead Optimization (JACS 2024): Side-chain decoration 和 Scaffold Hopping
   549	      可组合产生新化学型
   550	
   551	    算法（Murcko 骨架交换）:
   552	    1. 取 parent2 的 Murcko 骨架作为新核心
   553	    2. 从 parent1 移除 Murcko 骨架得到侧链
   554	    3. 将侧链连接到新核心上
   555	    4. 验证产物
   556	    """
   557	    if mol1 is None or mol2 is None:
   558	        return None
   559	    if mol1.GetNumAtoms() < 8 or mol2.GetNumAtoms() < 8:
   560	        return None
   561	
   562	    try:
   563	        # Step 1: 取 parent2 的 Murcko 骨架
   564	        core2 = MurckoScaffold.GetScaffoldForMol(mol2)
   565	        if core2 is None or core2.GetNumAtoms() < 3:
   566	            return None
   567	
   568	        # Step 2: 从 parent1 移除其 Murcko 骨架，得到侧链
   569	        core1 = MurckoScaffold.GetScaffoldForMol(mol1)
   570	        if core1 is None or core1.GetNumAtoms() < 3:
   571	            return None
   572	
   573	        side_chains = Chem.DeleteSubstructs(mol1, core1)
   574	        if side_chains is None or side_chains.GetNumAtoms() == 0:
   575	            # 尝试获取非环侧链
   576	            side_atoms = []
   577	            for a in mol1.GetAtoms():
   578	                if not a.IsInRing() and a.GetDegree() == 1:
   579	                    side_atoms.append(a.GetIdx())
   580	            if not side_atoms:
   581	                return None
   582	            # 用 RWMol 提取侧链
   583	            rw = Chem.RWMol(mol1)
   584	            atoms_to_keep = set()
   585	            for idx in side_atoms:
   586	                atom = mol1.GetAtomWithIdx(idx)
   587	                # 沿链追溯直到遇到环原子
   588	                visited = set()
   589	                stack = [idx]
   590	                while stack:
   591	                    aid = stack.pop()
   592	                    if aid in visited:
   593	                        continue
   594	                    visited.add(aid)
   595	                    a = mol1.GetAtomWithIdx(aid)
   596	                    if a.IsInRing() and aid not in side_atoms:
   597	                        continue
   598	                    atoms_to_keep.add(aid)
   599	                    for nbr in a.GetNeighbors():
   600	                        if nbr.GetIdx() not in visited and not nbr.IsInRing():
   601	                            stack.append(nbr.GetIdx())
   602	            atoms_to_remove = set(range(mol1.GetNumAtoms())) - atoms_to_keep
   603	            for aid in sorted(atoms_to_remove, reverse=True):
   604	                rw.RemoveAtom(aid)
   605	            side_chains = rw.GetMol()
   606	            if side_chains.GetNumAtoms() == 0:
   607	                return None
   608	
   609	        # Step 3: 找连接点
   610	        # 在 core2 上找可连接原子
   611	        core2_atoms = []
   612	        for a in core2.GetAtoms():
   613	            if a.GetAtomicNum() == 6 and a.GetDegree() < 4:
   614	                core2_atoms.append(a)
   615	        if not core2_atoms:
   616	            for a in core2.GetAtoms():
   617	                if a.GetDegree() < 4:
   618	                    core2_atoms.append(a)
   619	        if not core2_atoms:
   620	            return None
   621	
   622	        # 连接侧链到核心（最多2个侧链连接点）
   623	        combo = core2
   624	        n_attached = 0
   625	        max_attach = min(3, side_chains.GetNumAtoms() // 2 + 1)
   626	        attached_indices = set()
   627	
   628	        for frag in Chem.GetMolFrags(side_chains, asMols=True):
   629	            if n_attached >= max_attach:
   630	                break
   631	            if frag.GetNumAtoms() < 1:
   632	                continue
   633	
   634	            # 找侧链连接点
   635	            frag_anchors = []
   636	            for a in frag.GetAtoms():
   637	                if a.GetAtomicNum() != 0 and a.GetDegree() < a.GetExplicitValence():
   638	                    frag_anchors.append(a)
   639	            if not frag_anchors:
   640	                for a in frag.GetAtoms():
   641	                    if a.GetAtomicNum() != 0:
   642	                        frag_anchors.append(a)
   643	            if not frag_anchors:
   644	                continue
   645	
   646	            # 找可用核心连接点
   647	            available_core = [a for a in core2_atoms if a.GetIdx() not in attached_indices]
   648	            if not available_core:
   649	                break
   650	
   651	            # 组合并添加键
   652	            new_combo = Chem.CombineMols(combo, frag)
   653	            emol = Chem.EditableMol(new_combo)
   654	            core_anchor = random.choice(available_core)
   655	            frag_anchor = random.choice(frag_anchors)
   656	            frag_global_idx = combo.GetNumAtoms() + frag_anchor.GetIdx()
   657	
   658	            try:
   659	                emol.AddBond(core_anchor.GetIdx(), frag_global_idx, Chem.BondType.SINGLE)
   660	                combo = emol.GetMol()
   661	                Chem.SanitizeMol(combo)
   662	                attached_indices.add(core_anchor.GetIdx())
   663	                n_attached += 1
   664	            except Exception:
   665	                continue
   666	
   667	        if n_attached == 0:
   668	            return None
   669	
   670	        # Step 4: 最终验证
   671	        try:
   672	            Chem.SanitizeMol(combo)
   673	            new_smiles = Chem.MolToSmiles(combo, canonical=True)
   674	            verify = Chem.MolFromSmiles(new_smiles)
   675	            if verify is None:
   676	                return None
   677	            # 确保与父代不同
   678	            s1 = Chem.MolToSmiles(mol1, canonical=True)
   679	            s2 = Chem.MolToSmiles(mol2, canonical=True)
   680	            if new_smiles in (s1, s2):
   681	                return None
   682	            return combo
   683	        except Exception:
   684	            return None
   685	
   686	    except Exception:
   687	        return None
   688	
   689	
   690	def _brics_decompose_pool(smiles_list):
   691	    """对分子池做 BRICS 分解，收集唯一片段（H018）。
   692	
   693	    文献依据:
   694	    - JACS 2024: BRICS 16种可断裂键是分子碎片化的标准工具
   695	    - MOOSE-Chem (Yang et al., 2025): 片段重组是进化的核心操作
   696	
   697	    Args:
   698	        smiles_list: SMILES 字符串列表
   699	
   700	    Returns:
   701	        list[str]: 唯一的 BRICS 片段 SMILES（含 attachment point 标记如 [1*]）
   702	    """
   703	    all_frags = set()
   704	    for smi in smiles_list:
   705	        mol = Chem.MolFromSmiles(smi)
   706	        if mol is None:
   707	            continue
   708	        try:
   709	            frags = BRICS.BRICSDecompose(mol)
   710	            for f in frags:
   711	                # 过滤掉太小或纯 attachment point 的片段
   712	                f_mol = Chem.MolFromSmiles(f)
   713	                if f_mol is None:
   714	                    continue
   715	                n_heavy = f_mol.GetNumHeavyAtoms()
   716	                if n_heavy >= 2:
   717	                    all_frags.add(f)
   718	        except Exception:
   719	            continue
   720	    return list(all_frags)
   721	
   722	
   723	def _brics_recombine(fragment_smiles_list, n_molecules, max_attempts=500):
   724	    """BRICS 片段重组生成新分子（H018）。
   725	
   726	    从 BRICS 片段库中随机采样 2-4 个片段，用 BRICS Build 组合成新分子。
   727	    这实现了真正的化学片段重组（fragment recombination），而非字符串拼接。
   728	
   729	    文献依据:
   730	    - MOOSE-Chem (Yang et al., 2025): 重组(recombination)算子是进化核心驱动力
   731	    - MolLEO (Wang et al., 2024b): 多进化算子组合比单一算子更有效
   732	    - JACS 2024: BRICS 分解→重组是 Fragment Replacement 标准方法
   733	
   734	    Args:
   735	        fragment_smiles_list: BRICS 片段 SMILES 列表（含 attachment points）
   736	        n_molecules: 目标生成分子数
   737	        max_attempts: 最大尝试次数
   738	
   739	    Returns:
   740	        list[str]: 生成的唯一有效 SMILES 列表
   741	    """
   742	    if len(fragment_smiles_list) < 2:
   743	        return []
   744	
   745	    # 预解析片段为 Mol 对象
   746	    frag_mols = []
   747	    for f_smi in fragment_smiles_list:
   748	        m = Chem.MolFromSmiles(f_smi)
   749	        if m is not None:
   750	            frag_mols.append(m)
   751	
   752	    if len(frag_mols) < 2:
   753	        return []
   754	
   755	    molecules = set()
   756	    attempts = 0
   757	
   758	    while len(molecules) < n_molecules and attempts < max_attempts:
   759	        attempts += 1
   760	
   761	        # 随机选 2-4 个片段
   762	        n_frags = random.randint(2, min(4, len(frag_mols)))
   763	        selected = random.sample(frag_mols, n_frags)
   764	
   765	        # BRICS Build 生成所有可能的组合
   766	        try:
   767	            built = BRICS.BRICSBuild(selected)
   768	        except Exception:
   769	            continue
   770	
   771	        # 取前几个有效分子（避免组合爆炸）
   772	        n_taken = 0
   773	        for bmol in built:
   774	            if bmol is None:
   775	                continue
   776	            if n_taken >= 3:
   777	                break
   778	            try:
   779	                Chem.SanitizeMol(bmol)
   780	                smi = Chem.MolToSmiles(bmol, canonical=True)
   781	                # 排除仅由单个小片段组成的分子（无实际重组）
   782	                if smi in molecules:
   783	                    continue
   784	                # 过滤无效 SMILES
   785	                check_mol = Chem.MolFromSmiles(smi)
   786	                if check_mol is None or check_mol.GetNumHeavyAtoms() < 8:
   787	                    continue
   788	                # 类药性质过滤
   789	                props = evaluate_molecule(smi)
   790	                if passes_filters(props):
   791	                    molecules.add(smi)
   792	                    n_taken += 1
   793	            except Exception:
   794	                continue
   795	
   796	    return list(molecules)
   797	
   798	
   799	def _build_fragment_db_from_scaffolds():
   800	    """从 SCAFFOLDS 库构建 BRICS 片段库（H018 回退方案）。
   801	
   802	    当没有对接成功的分子池时，从硬编码骨架库 BRICS 分解得到片段。
   803	
   804	    Returns:
   805	        list[str]: BRICS 片段 SMILES 列表
   806	    """
   807	    all_frags = set()
   808	    for s_smi in SCAFFOLDS:
   809	        mol = Chem.MolFromSmiles(s_smi)
   810	        if mol is None:
   811	            continue
   812	        try:
   813	            # 先变异增加多样性再分解
   814	            for _ in range(3):
   815	                mutated = _mutate_mol(mol)
   816	                if mutated is not None:
   817	                    try:
   818	                        Chem.SanitizeMol(mutated)
   819	                        frags = BRICS.BRICSDecompose(mutated)
   820	                        for f in frags:
   821	                            f_mol = Chem.MolFromSmiles(f)
   822	                            if f_mol and f_mol.GetNumHeavyAtoms() >= 2:
   823	                                all_frags.add(f)
   824	                    except Exception:
   825	                        pass
   826	        except Exception:
   827	            continue
   828	    return list(all_frags)
   829	
   830	
   831	def generate_molecules(strategy="mutate", n_molecules=50, scaffold=None,
   832	                       fragment_pool=None):
   833	    """生成候选药物分子。
   834	
   835	    策略:
   836	        - "mutate": 从种子骨架变异
   837	        - "combine": BRICS 片段重组（H018 修复：不再字符串拼接）
   838	        - "random": 随机 SMILES 生成（非常基础）
   839	
   840	    H018 改进:
   841	        combine 策略从字符串拼接改为 BRICS 片段重组。
   842	        当提供 fragment_pool 时，从对接成功的分子池取片段（已验证化学型）；
   843	        否则从 SCAFFOLDS 库的变异产物中提取片段。
   844	
   845	    Args:
   846	        strategy: 生成策略
   847	        n_molecules: 目标分子数
   848	        scaffold: 可选种子骨架
   849	        fragment_pool: 可选的 SMILES 列表，用于 BRICS 分解（combine 策略使用）
   850	    """
   851	    molecules = set()
   852	    attempts = 0
   853	    max_attempts = n_molecules * 20
   854	
   855	    if strategy == "mutate":
   856	        seeds = SCAFFOLDS if scaffold is None else [scaffold]
   857	        # H021: 40% 概率从激酶铰链骨架采样，提升 TYK2 hinge 探索
   858	        # 仅在无显式 scaffold 参数时生效（保留 scaffold 参数的精确控制）
   859	        _use_kinase_bias = (scaffold is None and random.random() < 0.4)
   860	        while len(molecules) < n_molecules and attempts < max_attempts:
   861	            attempts += 1
   862	            if _use_kinase_bias:
   863	                # 每次迭代重新随机决定是否使用激酶偏置（保持多样性）
   864	                if random.random() < 0.4:
   865	                    seed = random.choice(KINASE_HINGE_SCAFFOLDS)
   866	                else:
   867	                    seed = random.choice(seeds)
   868	            else:
   869	                seed = random.choice(seeds)
   870	            n_mut = random.randint(1, 4)
   871	            new_smiles = random_mutate_smiles(seed, n_mut)
   872	            if new_smiles and new_smiles not in molecules:
   873	                props = evaluate_molecule(new_smiles)
   874	                if passes_filters(props):
   875	                    molecules.add(new_smiles)
   876	
   877	    elif strategy == "combine":
   878	        # H018 修复: 不再字符串拼接，使用 BRICS 片段重组
   879	        if fragment_pool and len(fragment_pool) >= 2:
   880	            # 从对接分子池提取 BRICS 片段 → 重组
   881	            frag_smiles = _brics_decompose_pool(fragment_pool)
   882	        else:
   883	            # 回退: 从 SCAFFOLDS 库构建片段库
   884	            frag_smiles = _build_fragment_db_from_scaffolds()
   885	
   886	        if len(frag_smiles) >= 2:
   887	            recombined = _brics_recombine(frag_smiles, n_molecules)
   888	            molecules.update(recombined)
   889	
   890	        # 如果 BRICS 重组产量不足，补充变异分子（H021: 激酶偏置）
   891	        if len(molecules) < n_molecules:
   892	            seeds = SCAFFOLDS if scaffold is None else [scaffold]
   893	            while len(molecules) < n_molecules and attempts < max_attempts:
   894	                attempts += 1
   895	                # H021: 40% 概率从激酶铰链骨架采样
   896	                if scaffold is None and random.random() < 0.4:
   897	                    seed = random.choice(KINASE_HINGE_SCAFFOLDS)
   898	                else:
   899	                    seed = random.choice(seeds)
   900	                n_mut = random.randint(1, 4)
   901	                new_smiles = random_mutate_smiles(seed, n_mut)
   902	                if new_smiles and new_smiles not in molecules:
   903	                    props = evaluate_molecule(new_smiles)
   904	                    if passes_filters(props):
   905	                        molecules.add(new_smiles)
   906	
   907	    elif strategy == "random":
   908	        # 非常基础：随机组合片段（H021: 激酶偏置）
   909	        while len(molecules) < n_molecules and attempts < max_attempts:
   910	            attempts += 1
   911	            # H021: 40% 概率从激酶铰链骨架采样
   912	            if scaffold is None and random.random() < 0.4:
   913	                frag = random.choice(KINASE_HINGE_SCAFFOLDS)
   914	            else:
   915	                frag = random.choice(SCAFFOLDS)
   916	            new_smiles = random_mutate_smiles(frag, random.randint(2, 5))
   917	            if new_smiles and new_smiles not in molecules:
   918	                props = evaluate_molecule(new_smiles)
   919	                if passes_filters(props):
   920	                    molecules.add(new_smiles)
   921	
   922	    result = [evaluate_molecule(s) for s in molecules]
   923	    result.sort(key=lambda x: x["qed"], reverse=True)
