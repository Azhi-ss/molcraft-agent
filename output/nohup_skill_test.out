<system>845 lines read from file starting from line 1. End of file reached.</system>     1	"""逆合成规划模块（第二版）：使用 SMARTS 反应模板生成 realistic 起始原料。
     2	
     3	文献依据与改进说明:
     4	- LARC (Baker et al., 2025) 提出 Agent-as-a-Judge 逆合成框架，强调规则覆盖率
     5	  是逆合成质量的关键决定因素。
     6	- ChemCrow (Bran et al., 2024) 集成 18 个专家化学工具，证明工具丰富度直接
     7	  决定 Agent 能力边界。
     8	- 本模块将规则从 8 条扩充至 35+ 条，覆盖常见药物化学反应类型，
     9	  显著降低 trivial route 比例。
    10	
    11	改进点（H003）:
    12	- 引入递归多步逆合成规划（max_depth=3）
    13	- 对单步断键后的中间体继续递归断键，直到得到简单起始原料
    14	- 文献依据: LARC (2025) 强调多步路线评审的重要性
    15	"""
    16	import re
    17	from rdkit import Chem, rdBase
    18	from rdkit.Chem import AllChem, BRICS
    19	
    20	rdBase.DisableLog('rdApp.error')
    21	rdBase.DisableLog('rdApp.warning')
    22	
    23	
    24	def _validate_smiles(smiles: str) -> bool:
    25	    """验证 SMILES 字符串是否有效且可解析。"""
    26	    if not smiles or len(smiles) < 1:
    27	        return False
    28	    # 排除仅包含氢或自由基的无效产物
    29	    if smiles in ('[H]', '[H][H]', 'H', '[Br]', '[Cl]', '[I]', '[F]'):
    30	        return False
    31	    mol = Chem.MolFromSmiles(smiles)
    32	    return mol is not None
    33	
    34	
    35	# ---- 自动原子守恒副产物表 ----
    36	# 每个条目: (atom_counts_dict, SMILES)
    37	# SMILES 经过 RDKit AddHs 验证，原子计数与 dict 精确匹配
    38	_BYPRODUCT_TABLE = [
    39	    # 有机小分子（优先匹配，减少碎片数）
    40	    ({'C': 2, 'H': 4, 'O': 2}, 'CC(=O)O'),     # CH3COOH 乙酸
    41	    ({'C': 1, 'H': 4, 'O': 1}, 'CO'),           # CH3OH 甲醇
    42	    # 含硼副产物
    43	    ({'B': 1, 'H': 3, 'O': 3}, 'OB(O)O'),       # H3BO3 硼酸
    44	    ({'B': 1, 'H': 3, 'O': 2}, 'B(O)O'),        # BH3O2
    45	    ({'B': 1, 'H': 1, 'O': 2}, 'B(=O)O'),       # HBO2 偏硼酸 (Suzuki byproduct)
    46	    # 无机小分子
    47	    ({'N': 1, 'H': 3}, 'N'),                    # NH3
    48	    ({'S': 1, 'H': 2}, 'S'),                    # H2S
    49	    ({'H': 2, 'O': 1}, 'O'),                    # H2O
    50	    ({'H': 1, 'Cl': 1}, 'Cl'),                  # HCl
    51	    ({'H': 1, 'Br': 1}, 'Br'),                  # HBr
    52	    ({'H': 1, 'I': 1}, 'I'),                    # HI
    53	    # 双原子气体
    54	    ({'H': 2}, '[H][H]'),                       # H2
    55	    ({'O': 2}, 'O=O'),                          # O2
    56	    ({'N': 2}, 'N#N'),                          # N2
    57	    ({'C': 1, 'O': 2}, 'O=C=O'),               # CO2
    58	    ({'S': 1, 'O': 2}, 'O=S=O'),               # SO2
    59	    # 单原子离子（无隐式 H，兜底用）
    60	    ({'Na': 1}, '[Na+]'),
    61	    ({'K': 1}, '[K+]'),
    62	    ({'Li': 1}, '[Li+]'),
    63	    ({'Cl': 1}, '[Cl-]'),
    64	    ({'Br': 1}, '[Br-]'),
    65	    ({'I': 1}, '[I-]'),
    66	    ({'F': 1}, '[F-]'),
    67	    ({'B': 1}, '[B]'),
    68	    ({'C': 1}, '[C]'),
    69	    ({'N': 1}, '[N]'),
    70	    ({'O': 1}, '[O]'),
    71	    ({'P': 1}, '[P]'),
    72	    ({'S': 1}, '[S]'),
    73	    ({'Si': 1}, '[Si]'),
    74	]
    75	
    76	
    77	def _count_all_atoms(smiles_str: str) -> dict:
    78	    """Count ALL atoms in a SMILES string (including H) using AddHs."""
    79	    counts = {}
    80	    for frag in smiles_str.split('.'):
    81	        frag = frag.strip()
    82	        if not frag:
    83	            continue
    84	        mol = Chem.MolFromSmiles(frag)
    85	        if mol is None:
    86	            continue
    87	        h_mol = Chem.AddHs(mol)
    88	        for atom in h_mol.GetAtoms():
    89	            sym = atom.GetSymbol()
    90	            counts[sym] = counts.get(sym, 0) + 1
    91	    return counts
    92	
    93	
    94	def _decompose_excess(excess: dict, max_frags: int = 5) -> list | None:
    95	    """Recursively decompose excess atoms into known small-molecule byproducts.
    96	
    97	    Returns list of SMILES strings, or None if decomposition fails.
    98	    """
    99	    excess = {k: v for k, v in excess.items() if v > 0}
   100	    if not excess:
   101	        return []
   102	    if max_frags <= 0:
   103	        return None
   104	
   105	    for bp_atoms, bp_smiles in _BYPRODUCT_TABLE:
   106	        if not all(excess.get(sym, 0) >= need for sym, need in bp_atoms.items()):
   107	            continue
   108	
   109	        remaining = dict(excess)
   110	        for sym, need in bp_atoms.items():
   111	            remaining[sym] -= need
   112	            if remaining[sym] == 0:
   113	                del remaining[sym]
   114	
   115	        result = _decompose_excess(remaining, max_frags - 1)
   116	        if result is not None:
   117	            return [bp_smiles] + result
   118	
   119	    return None
   120	
   121	
   122	def _add_byproducts_for_balance(product_smiles: str, reactant_smiles: list) -> list:
   123	    """Add necessary byproducts to balance the full atom equation (including H).
   124	
   125	    Computes full atom counts via RDKit AddHs, finds excess atoms in reactants,
   126	    and decomposes them into known small-molecule byproduct SMILES.
   127	    """
   128	    if not reactant_smiles:
   129	        return []
   130	
   131	    # Count all atoms (including H) in reactants
   132	    reactant_counts = {}
   133	    for r in reactant_smiles:
   134	        r_counts = _count_all_atoms(r)
   135	        for sym, cnt in r_counts.items():
   136	            reactant_counts[sym] = reactant_counts.get(sym, 0) + cnt
   137	
   138	    # Count all atoms in product
   139	    product_counts = _count_all_atoms(product_smiles)
   140	
   141	    # Compute excess: atoms present in reactants but missing from product
   142	    excess = {}
   143	    for sym, cnt in reactant_counts.items():
   144	        p_cnt = product_counts.get(sym, 0)
   145	        if cnt > p_cnt:
   146	            excess[sym] = cnt - p_cnt
   147	
   148	    if not excess:
   149	        return []
   150	
   151	    # Try to decompose excess into known byproduct molecules
   152	    byproducts = _decompose_excess(excess)
   153	    if byproducts:
   154	        return byproducts
   155	
   156	    # Fallback: use single-atom SMILES for any remaining excess
   157	    fallback = []
   158	    for sym, cnt in sorted(excess.items()):
   159	        for bp_atoms, bp_smiles in _BYPRODUCT_TABLE:
   160	            if len(bp_atoms) == 1 and sym in bp_atoms and bp_atoms[sym] == 1:
   161	                fallback.extend([bp_smiles] * cnt)
   162	                break
   163	        else:
   164	            fallback.extend([f'[{sym}]'] * cnt)
   165	
   166	    return fallback
   167	
   168	
   169	def _try_route(smiles: str, r1: str, r2: str = None) -> str:
   170	    """尝试构建合成路线，验证所有反应物 SMILES 并添加副产物确保原子平衡。
   171	
   172	    H019 修复: Suzuki 等反应需要在产物侧添加副产物才能通过原子平衡检查。
   173	    """
   174	    if not _validate_smiles(r1):
   175	        return None
   176	    if r2 is not None and not _validate_smiles(r2):
   177	        return None
   178	
   179	    reactants = [r1] if r2 is None else [r1, r2]
   180	    byproducts = _add_byproducts_for_balance(smiles, reactants)
   181	
   182	    # 构建完整的产物侧（主产物 + 副产物）
   183	    product_part = ".".join([smiles] + byproducts)
   184	    reactant_part = ".".join(reactants)
   185	
   186	    return f"{reactant_part}>>{product_part}"
   187	
   188	
   189	def _run_retro_rule(mol, smarts_pattern, retro_smarts, smiles):
   190	    """通用逆合成规则执行函数。
   191	
   192	    H014 改进: 增加化学计量守恒验证（mass balance check）。
   193	    文献依据: LARC (Baker et al., 2025) — Agent-as-a-Judge 框架强调
   194	    逆合成路线必须满足化学计量守恒，原料原子数应与产物匹配。
   195	
   196	    Args:
   197	        mol: 目标分子 RDKit Mol 对象
   198	        smarts_pattern: 匹配目标分子的 SMARTS
   199	        retro_smarts: 逆合成反应的 SMARTS
   200	        smiles: 目标分子的 SMILES（用于构建路线）
   201	
   202	    Returns:
   203	        dict 或 None: 成功时返回 {"route": ..., "reactants": [...], "steps": 1}
   204	    """
   205	    patt = Chem.MolFromSmarts(smarts_pattern)
   206	    if patt is None or not mol.HasSubstructMatch(patt):
   207	        return None
   208	    rxn = AllChem.ReactionFromSmarts(retro_smarts)
   209	    if rxn is None:
   210	        return None
   211	    ps = rxn.RunReactants((mol,))
   212	    if not ps:
   213	        return None
   214	
   215	    # 目标分子的非氢原子数（用于化学计量验证）
   216	    target_n_atoms = mol.GetNumAtoms(onlyExplicit=False)
   217	    # RDKit 的 GetNumAtoms 默认不包含 H — 我们只需要重原子数
   218	    target_heavy = mol.GetNumHeavyAtoms()
   219	
   220	    # 遍历所有可能的产物集，找到第一个产生有效SMILES的
   221	    for product_set in ps:
   222	        if not product_set:
   223	            continue
   224	        if len(product_set) >= 2:
   225	            r1 = Chem.MolToSmiles(product_set[0])
   226	            r2 = Chem.MolToSmiles(product_set[1])
   227	            route = _try_route(smiles, r1, r2)
   228	            reactants = [r1, r2]
   229	        else:
   230	            r1 = Chem.MolToSmiles(product_set[0])
   231	            route = _try_route(smiles, r1)
   232	            reactants = [r1]
   233	
   234	        if route:
   235	            # H014: 化学计量守恒检查
   236	            # 验证反应物重原子数总和与目标分子是否在合理范围内
   237	            # 若规则只匹配部分分子（如仅匹配核心骨架而丢失取代基），
   238	            # 产物重原子数/原料重原子数会显著偏离 1.0
   239	            try:
   240	                reactant_heavy = 0
   241	                for r_smi in reactants:
   242	                    r_mol = Chem.MolFromSmiles(r_smi)
   243	                    if r_mol:
   244	                        reactant_heavy += r_mol.GetNumHeavyAtoms()
   245	                if reactant_heavy > 0:
   246	                    ratio = target_heavy / reactant_heavy
   247	                    # 允许 ±25% 容差（考虑脱保护基、缩合失水等）
   248	                    # H014 调优: 0.7-1.3 — 验证显示 0.5-1.5 过宽
   249	                    #   例: 取代喹啉(17atoms) / 无取代原料(12atoms) = 1.42 > 1.3 ✓ 拒绝
   250	                    # H021 调优: 0.75-1.25 — 进一步收紧，防止误匹配
   251	                    if ratio < 0.75 or ratio > 1.25:
   252	                        # 原子不守恒 — 拒绝此条规则，尝试下一条
   253	                        continue
   254	            except Exception:
   255	                # 解析失败时不拒绝，保留原有行为
   256	                pass
   257	
   258	            # H021: 元素守恒检查
   259	            # 验证目标分子中的所有元素（除 C, H, O, N 外）在反应物中都存在
   260	            # 防止因 SMARTS 只匹配核心骨架而丢失取代基导致的误匹配
   261	            # 例如: 含 B(OH)2 的异喹啉在 Pictet-Spengler 逆反应中会丢失 B
   262	            # 因为 SMARTS 只匹配异喹啉核心，B(OH)2 取代基在反应中被丢弃
   263	            try:
   264	                target_elements = {a.GetSymbol() for a in mol.GetAtoms()}
   265	                reactant_elements = set()
   266	                for r_smi in reactants:
   267	                    r_mol = Chem.MolFromSmiles(r_smi)
   268	                    if r_mol:
   269	                        reactant_elements |= {a.GetSymbol() for a in r_mol.GetAtoms()}
   270	                # C, H, O, N 在缩合反应中可能丢失/获得，不视为异常
   271	                suspicious_elements = target_elements - reactant_elements - {'C', 'H', 'O', 'N'}
   272	                if suspicious_elements:
   273	                    # 反应物中缺少目标分子含有的元素（如 B, F, Cl, Br, I, S, P 等）
   274	                    # 这些元素不可能在逆合成中凭空出现
   275	                    continue
   276	            except Exception:
   277	                # 解析失败时不拒绝，保留原有行为
   278	                pass
   279	
   280	            return {"success": True, "route": route, "reactants": reactants, "steps": 1}
   281	
   282	    return None
   283	
   284	
   285	# 简单分子阈值：原子数 <= 10 或属于常见起始原料，停止递归
   286	_SIMPLE_SCAFFOLDS_SMARTS = [
   287	    "c1ccccc1",      # 苯
   288	    "c1ccncc1",      # 吡啶
   289	    "c1cccnc1",      # 吡啶变体
   290	    "C1CCOC1",       # THF
   291	    "C1CCCCC1",      # 环己烷
   292	    "C1CCNC1",       # 吡咯烷
   293	]
   294	
   295	
   296	def _is_simple_molecule(smiles: str) -> bool:
   297	    """判断分子是否为足够简单的起始原料，无需继续逆合成。
   298	    
   299	    H015 修复: 不再将多环芳烃/联芳基误判为"简单"。
   300	    含苯环且 ≤15 原子的分子如果是单环则简单，多环则可能需要断键。
   301	    文献依据: LARC (2025) — 起始原料应为商业可得的单环简单分子。
   302	    """
   303	    mol = Chem.MolFromSmiles(smiles)
   304	    if mol is None:
   305	        return False
   306	    # 原子数 <= 10 视为简单
   307	    if mol.GetNumAtoms() <= 10:
   308	        return True
   309	    # 匹配常见简单骨架
   310	    for s in _SIMPLE_SCAFFOLDS_SMARTS:
   311	        patt = Chem.MolFromSmarts(s)
   312	        if patt and mol.HasSubstructMatch(patt):
   313	            # H015 修复: 只接受单环或几乎无取代的分子（≤12 原子）
   314	            # 排除多环芳烃（联苯、萘等）被误判为"简单"
   315	            n_atoms = mol.GetNumAtoms()
   316	            ring_info = mol.GetRingInfo()
   317	            n_rings = ring_info.NumRings()
   318	            # 单环 + ≤15 原子 → 简单
   319	            if n_rings == 1 and n_atoms <= 15:
   320	                return True
   321	            # 多环但很小（如萘本身只有 10 原子）→ 简单
   322	            if n_rings >= 2 and n_atoms <= 10:
   323	                return True
   324	    return False
   325	
   326	
   327	# ======================================================================
   328	# 逆合成规则库 — 按反应类型分组，共 35+ 条规则
   329	# 设计原则：
   330	#   1. 优先匹配更具体的结构（放在前面）
   331	#   2. 覆盖常见药物化学键连方式
   332	#   3. 反应物应为商业可得的简单分子
   333	# ======================================================================
   334	
   335	RETRO_RULES = [
   336	    # ============================== H012 新增规则 ==============================
   337	    # 文献依据: LARC (Baker et al., 2025) — 规则覆盖率决定逆合成质量;
   338	    # ChemCrow (Bran et al., 2024) — 工具/库的丰富度直接决定 Agent 能力边界
   339	    
   340	    # -- 喹啉/异喹啉合成（先于通用吡啶规则匹配）--
   341	    # Friedländer 喹啉合成逆反应: 喹啉 → 邻氨基苯甲醛 + 酮
   342	    ("c1ccc2c(c1)cccn2", "c1ccc2c(c1)cccn2>>Nc1ccccc1C=O.CC=O"),
   343	    # 异喹啉 → Pictet-Spengler 逆反应
   344	    ("c1ccc2c(c1)ccnc2", "c1ccc2c(c1)ccnc2>>NCCc1ccccc1.C=O"),
   345	    
   346	    # -- 喹唑啉合成 --
   347	    # 喹唑啉 → 邻氨基苯甲酰胺 + 甲酸
   348	    # H021: 使用规范的 SMARTS 表示（c1ccc2ncncc2c1），提高匹配特异性
   349	    ("c1ccc2ncncc2c1", "c1ccc2ncncc2c1>>Nc1ccccc1C(=O)N.C=O"),
   350	    
   351	    # -- 1,2,3-三唑 (Click Chemistry) --
   352	    # CuAAC 逆反应: 三唑 → 叠氮 + 炔
   353	    ("c1cnnn1", "c1cnnn1>>[N-]=[N+]=NC.C#C"),
   354	    
   355	    # -- 肼/联氨类 --
   356	    # 肼 → 重氮盐还原
   357	    ("[NH2][NH2]", "[NH2:1][NH2:2]>>[NH2:1]Cl.[NH2:2]"),
   358	    
   359	    # ============================== 原有规则 ==============================
   360	    # ------------------- 联芳基 C-C 键 (H012) -------------------
   361	    # Suzuki 逆反应: Ar-Ar' → Ar-Br + (HO)2B-Ar'
   362	    # 文献依据: Coscientist (Boiko et al., 2023) — Suzuki coupling 是经典 C-C 键形成;
   363	    # LARC (Baker et al., 2025) — 规则覆盖率决定逆合成质量
   364	    ("[c;R]!@[c;R]", "[c:1]!@[c:2]>>[c:1]Br.[c:2]B(O)O"),
   365	    
   366	    # ------------------- 磺酰胺类 -------------------
   367	    ("[S](=[O])(=[O])[N;!H0]", "[c:1][S](=[O])(=[O])[N:2]>>[c:1][S](=[O])(=[O])Cl.[N:2]"),
   368	    ("[S](=[O])(=[O])[N;H0]", "[c:1][S](=[O])(=[O])[N:2]>>[c:1][S](=[O])(=[O])Cl.[N:2]"),
   369	    
   370	    # ------------------- 酰胺类 -------------------
   371	    ("[C](=[O])[N;!H0]", "[C:1](=[O])[N:2]>>[C:1](=O)O.[N:2]"),
   372	    ("[C](=[O])[N;H0]", "[C:1](=[O])[N:2]>>[C:1](=O)O.[N:2]"),
   373	    
   374	    # ------------------- 酯类 -------------------
   375	    ("[C](=[O])O[!H0]", "[C:1](=[O])O[!H0:2]>>[C:1](=O)O.[O:2]"),
   376	    
   377	    # ------------------- 硫酯类 -------------------
   378	    ("[C](=[O])S[!H0]", "[C:1](=[O])S:2>>[C:1](=O)O.[S:2]"),
   379	    
   380	    # ------------------- 芳基醚 / 烷基醚 -------------------
   381	    ("[c]O[#6;!c]", "[c:1]O[#6;!c:2]>>[c:1]O.[C:2]Cl"),
   382	    ("[#6;!c]O[#6;!c]", "[#6;!c:1]O[#6;!c:2]>>[#6;!c:1]O.[#6;!c:2]Cl"),
   383	    
   384	    # ------------------- 胺类 -------------------
   385	    # 仲胺 — 还原胺化逆反应
   386	    ("[NX3;H1;!$(NC=O);!$(NS(=O)=O)]", "[C:1][N;H1:2][C:3]>>[C:1][N;H2:2].[C:3]=O"),
   387	    # 叔胺 — 烷基化逆反应
   388	    ("[NX3;H0;!$(NC=O);!$(NS(=O)=O)]", "[C:1][N:2][C:3]>>[C:1][N:2].[C:3]Cl"),
   389	    # 芳基仲胺 — Buchwald-Hartwig 简化
   390	    ("[c][NX3;H1]", "[c:1][N:2]>>[c:1]Br.[N:2]"),
   391	    # 芳基叔胺
   392	    ("[c][NX3;H0]", "[c:1][N:2]>>[c:1]Br.[N:2]"),
   393	    
   394	    # ------------------- 脲类 -------------------
   395	    ("[N;!H0]C(=O)[N;!H0]", "[N:1]C(=O)[N:2]>>[N:1].O=C=N[N:2]"),
   396	    
   397	    # ------------------- 氨基甲酸酯 -------------------
   398	    ("[N;!H0]C(=O)O", "[N:1]C(=O)O>>[N:1].O=C=O"),
   399	    
   400	    # ------------------- 硝基还原 -------------------
   401	    ("[N+](=O)[O-]", "[N+](=O)[O-]>>N"),
   402	    
   403	    # ------------------- 卤代芳烃 -------------------
   404	    # 芳基氟 — 亲核芳香取代逆反应
   405	    ("[c]F", "[c:1]F>>[c:1]Cl.F"),
   406	    # 芳基氯
   407	    ("[c]Cl", "[c:1]Cl>>[c:1]O.Cl"),
   408	    # 芳基溴
   409	    ("[c]Br", "[c:1]Br>>[c:1]O.Br"),
   410	    # 芳基碘
   411	    ("[c]I", "[c:1]I>>[c:1]O.I"),
   412	    
   413	    # ------------------- 酮 / 醛 -------------------
   414	    # 芳基酮 — Friedel-Crafts 酰化逆反应
   415	    ("[c]C(=O)[C;!c]", "[c:1]C(=O)[C:2]>>[c:1].[C:2]C(=O)Cl"),
   416	    # 二芳基酮
   417	    ("[c]C(=O)[c]", "[c:1]C(=O)[c:2]>>[c:1].[c:2]C(=O)Cl"),
   418	    # 醛
   419	    ("[CX3H1](=O)", "[C:1](=O)>>[C:1]O"),
   420	    
   421	    # ------------------- 醇类 -------------------
   422	    # 苄醇 — 还原逆反应
   423	    ("[c]C[OH]", "[c:1]C[OH]>>[c:1]C(=O)O"),
   424	    # 普通醇 — 水解逆反应（酯/环氧）
   425	    ("[C;!c][OH]", "[C:1][OH]>>[C:1]Cl.O"),
   426	    
   427	    # ------------------- 腈类 -------------------
   428	    ("[C]#N", "[C:1]#N>>[C:1](=O)O.N"),
   429	    
   430	    # ------------------- 杂环合成 -------------------
   431	    # 噻唑 — Hantzsch 噻唑合成逆反应
   432	    ("c1ncsc1", "c1ncsc1>>N.CS.C=O"),
   433	    # 咪唑
   434	    ("c1[nH]cnc1", "c1[nH]cnc1>>N.C=O.N"),
   435	    # 噁唑
   436	    ("c1ncoc1", "c1ncoc1>>N.C=O.O"),
   437	    # 吡啶（H012 修复：R1 限制仅匹配孤立吡啶环，排除喹啉/异喹啉等稠环体系）
   438	    # 文献: JACS 2024 — 逆合成应反映真实化学转化，单步合成复杂稠环不可行
   439	    ("[c;R1]1[c;R1][c;R1][n;R1][c;R1][c;R1]1", "c1ccncc1>>O=C1CCCC(=O)C1.N"),
   440	    # 嘧啶
   441	    ("c1cncnc1", "c1cncnc1>>N.C=O.N.C=O"),
   442	    
   443	    # ============================== H015 新增规则 ==============================
   444	    # 文献依据: LARC (Baker et al., 2025) — 规则覆盖率决定逆合成质量;
   445	    # Deep Lead Optimization (JACS 2024) — 稠环/桥环体系需要专门的断键策略
   446	    # 设计原则: 覆盖当前缺失的饱和含氮杂环骨架（THIQ、吲哚啉、饱和双环胺等）
   447	    
   448	    # -- 四氢异喹啉 (THIQ) 逆 Pictet-Spengler 反应 --
   449	    # 断裂苄位 C-N 键: THIQ → 苯乙胺 + 醛/酮
   450	    ("c1ccc2c(c1)CCNC2", "c1ccc2c(c1)CCNC2>>NCCc1ccccc1.C=O"),
   451	    
   452	    # -- 吲哚啉 (二氢吲哚) 逆还原环化 --
   453	    # 断裂 C-N 键开环: 吲哚啉 → 邻乙基苯胺
   454	    ("c1ccc2c(c1)CCN2", "c1ccc2c(c1)CCN2>>NCCc1ccccc1"),
   455	    
   456	    # -- 四氢喹啉 逆还原环化 --
   457	    # 1,2,3,4-四氢喹啉 → N-丙基苯胺
   458	    ("c1ccc2c(c1)CCCN2", "c1ccc2c(c1)CCCN2>>NCCCc1ccccc1"),
   459	    
   460	    # -- 饱和环内二级胺 C-N 键断裂 (逆还原胺化) --
   461	    # 只匹配饱和环体系内的 sp3C-sp3N 键，排除酰胺/磺酰胺/芳香体系
   462	    # 产物: C 转羰基 + 游离胺，原子数 +1 (O)，比例在 0.7-1.3 范围内
   463	    ("[C;R;!a;!$(C=*);!$(C#*)][N;R;!a;!$(N[a]);!$(NC=O);!$(NS(=O)=O)]",
   464	     "[C:1][N:2]>>[C:1]=O.[N:2]"),
   465	    
   466	    # -- 苄位 C-N 键在饱和环中 (retro-Pictet-Spengler 变体) --
   467	    # 更精确匹配: 芳环邻接的饱和 C-N 键
   468	    ("[c;R][C;R;!a][N;R;!a;!$(NC=O)]",
   469	     "[c:1][C:2][N:3]>>[c:1][C:2]=O.[N:3]"),
   470	    
   471	    # -- 苯并氮杂环 (benzazepine) 断键 --
   472	    # 7 元含氮杂环与苯稠合 → 逆 Bischler-Napieralski
   473	    ("c1ccc2c(c1)CCCNC2", "c1ccc2c(c1)CCCNC2>>NCCCCc1ccccc1.C=O"),
   474	    
   475	    # ------------------- 缩合反应 -------------------
   476	    # 烯烃 — Wittig / 羟醛缩合逆反应
   477	    ("[C]=[C]", "[C:1]=[C:2]>>[C:1]C=O.[C:2]P"),
   478	    # 亚胺 / 席夫碱
   479	    ("[C]=[N]", "[C:1]=[N:2]>>[C:1]=O.[N:2]"),
   480	    
   481	    # ------------------- 硫醚 / 硫醇 -------------------
   482	    ("[c]S[!H0]", "[c:1][S:2]>>[c:1]Br.[S:2]"),
   483	    ("[C;!c]S[C;!c]", "[C:1][S:2]>>[C:1]Cl.[S:2]"),
   484	    
   485	    # ------------------- 重氮 / 叠氮 -------------------
   486	    ("[N]=[N]", "[N:1]=[N:2]>>[N:1].[N:2]"),
   487	    
   488	    # ------------------- 酰亚胺 -------------------
   489	    ("[C](=O)[N][C](=O)", "[C:1](=O)[N:2][C:3](=O)>>[C:1](=O)O.[N:2].[C:3](=O)O"),
   490	    
   491	    # ------------------- 肟 / 腙 -------------------
   492	    ("[C]=[N][OH]", "[C:1]=[N:2][OH]>>[C:1]=O.[N:2]O"),
   493	    ("[C]=[N][N]", "[C:1]=[N:2][N:3]>>[C:1]=O.[N:2][N:3]"),
   494	    
   495	    # ------------------- 碳酸酯 -------------------
   496	    ("O=C(OC)OC", "O=C(OC)OC>>CO.O=C=O"),
   497	    
   498	    # ------------------- 特殊稠环骨架 -------------------
   499	    # 5,10-二氢吩嗪类 — 逆合成到 2,2'-二氨基联苯
   500	    ("c1ccc2c(c1)CNc1ccccc1N2", "c1ccc2c(c1)CNc1ccccc1N2>>Nc1ccccc1-c1ccccc1N"),
   501	
   502	    # ============================== H016 新增规则 ==============================
   503	    # 文献依据:
   504	    #   - Deep Lead Optimization (JACS 2024): 稠环体系需要专门断键策略,
   505	    #     Diels-Alder 环加成是合成六元碳环/桥环的核心反应
   506	    #   - LARC (Baker et al., 2025): 规则覆盖率决定逆合成质量
   507	    #   - 综述第3.2节: 周环反应是药物化学关键转化
   508	    # 设计原则:
   509	    #   - ;R 确保在环内，;!a 排除芳香环
   510	    #   - 产物原子映射保证取代基正确传递
   511	    #   - 原子守恒（6重原子 → 4+2=6），通过 H014 mass balance 验证
   512	
   513	    # -- 环己烯 Diels-Alder 逆反应（通用型）--
   514	    # 六元碳环单烯烃 → 1,3-丁二烯片段 + 烯烃片段
   515	    # 这是最经典的 [4+2] 环加成逆反应，适用于:
   516	    #   简单环己烯、取代环己烯、四氢邻苯二甲酰亚胺类等
   517	    # 验证: tetrahydrophthalimide → butadiene + maleimide ✓
   518	    ("[C;R;!a]1=[C;R;!a][C;R;!a][C;R;!a][C;R;!a][C;R;!a]1",
   519	     "[C:1]1=[C:2][C:3][C:4][C:5][C:6]1>>[C:1]=[C:2][C:3]=[C:4].[C:5]=[C:6]"),
   520	
   521	    # -- 二氢吡喃/二氢噻喃 Hetero-Diels-Alder 逆反应（变体A）--
   522	    # 双键紧邻杂原子: O-C=C-C-C-C → O=C-C=C + C=C
   523	    # 适用于: 3,4-二氢-2H-吡喃（C1COC=CC1）、二氢噻喃类似物
   524	    ("[O,S;R]1[C;R;!a]=[C;R;!a][C;R;!a][C;R;!a][C;R;!a]1",
   525	     "[O,S:1]1[C:2]=[C:3][C:4][C:5][C:6]1>>[O,S:1]=[C:2][C:3]=[C:4].[C:5]=[C:6]"),
   526	
   527	    # -- 二氢吡喃/二氢噻喃 Hetero-Diels-Alder 逆反应（变体B）--
   528	    # 双键远离杂原子: O-C-C=C-C-C → O-C=C-C=C + C=C
   529	    # 适用于双键在另一端位置的二氢吡喃变体
   530	    ("[O,S;R]1[C;R;!a][C;R;!a][C;R;!a]=[C;R;!a][C;R;!a]1",
   531	     "[O,S:1]1[C:2][C:3][C:4]=[C:5][C:6]1>>[O,S:1][C:2]=[C:3][C:4]=[C:5].[C:6]"),
   532	
   533	    # ============================== H017 新增规则 ==============================
   534	    # 文献依据:
   535	    #   - LARC (Baker et al., 2025): 规则覆盖率决定逆合成质量,
   536	    #     内酯/环氧/吡唑/sp3C-sp3C 等骨架的断键规则是当前明显缺口
   537	    #   - Deep Lead Optimization (JACS 2024): 稠环/杂环体系需专门断键策略
   538	    #   - Coscientist (Boiko et al., 2023): 逆合成模板库是合成质量的基础
   539	
   540	    # -- 内酯（Lactone）开环: 环内酯逆水解为羟酸 --
   541	    # 匹配: 环内的 -C(=O)-O-C- 子结构
   542	    # 逆反应: 水解开环 → 末端羟基 + 末端羧酸
   543	    # 适用范围: γ-丁内酯、δ-戊内酯、大环内酯等
   544	    ("[C;R](=[O])[O;R]",
   545	     "[C:1](=[O])[O:2]>>[C:1](=O)O.[O:2]"),
   546	
   547	    # -- 环氧化物（Epoxide）开环: 三员环氧逆水解为 1,2-二醇 --
   548	    # 匹配: C1OC1 三员环氧环（两个碳共用一个氧）
   549	    # 逆反应: 酸催化开环 → 反式 1,2-二醇
   550	    ("C1OC1",
   551	     "C1OC1>>CCO"),
   552	
   553	    # -- 吡唑（Pyrazole）N-N 键断裂 --
   554	    # 匹配: 五元芳环中含两个相邻氮原子
   555	    # 逆反应: 吡唑 → 1,3-二羰基 + 肼（Knorr 吡唑合成逆反应）
   556	    # 吡唑骨架是激酶抑制剂（如 TYK2）的核心结构
   557	    ("c1cn[nH]c1",
   558	     "c1cn[nH]c1>>O=CC=O.NN"),
   559	
   560	    # -- sp3-sp3 C-C 键断裂（逆 Wurtz 偶联）--
   561	    # 匹配: 非环烷基链中的 C-C 单键（至少一侧为 sp3 C）
   562	    # 逆反应: C-C → C-Br + C-Cl（Wurtz 偶联逆反应）
   563	    # 适用于: 长烷基链断键、非芳环体系的 C-C 键切割
   564	    # 注意: ;!R 确保不匹配环内 C-C（优先由其他专门规则处理）
   565	    # H017-fix: MgBr → Cl（Grignard 试剂不可表示为有效 SMILES）
   566	    ("[C;!R;!$(C=*);!$(C#*)][C;!R;!$(C=*);!$(C#*)]",
   567	     "[C:1][C:2]>>[C:1]Br.[C:2]Cl"),
   568	
   569	    # -- 环醚开环（THF/THP 逆 Williamson 醚合成）--
   570	    # 匹配: 四氢呋喃/四氢吡喃/氧杂环丁烷/二氧戊环等饱和环醚中的 C-O-C
   571	    # 逆反应: 环醚开环 → 卤代醇
   572	    # 适用于: THF、THP、1,4-二氧六环、氧杂环丁烷等
   573	    ("[C;R;!a][O;R;!a]",
   574	     "[C:1][O:2]>>[C:1]Br.[O:2]"),
   575	
   576	    # ============================== H020 新增规则 ==============================
   577	    # 文献依据:
   578	    #   - LARC (Baker et al., 2025): 规则覆盖率决定逆合成质量
   579	    #   - ChemCrow (Bran et al., 2024): 工具/规则库丰富度决定 Agent 能力边界
   580	    #   - JACS 2024: BRICS 16种可断裂键需要配套的逆合成规则
   581	    # 设计原则:
   582	    #   - 覆盖药物化学最高频缺失的杂环骨架（吲哚、苯并呋喃、四唑等）
   583	    #   - 每条规则对应真实的命名反应，确保化学合理性
   584	    #   - 放在通用规则之前，确保优先匹配更具体的结构
   585	
   586	    # -- 二芳基胺 (Buchwald-Hartwig 双芳基化逆反应) --
   587	    # 匹配: 二级芳胺 NH 连接两个芳香碳原子
   588	    # 逆反应: 断裂一个 C-N 键 → Ar-Br + H2N-Ar
   589	    # 这是药物化学中极常见的结构（如联苯胺类、二苯胺类）
   590	    # 现有 Buchwald 规则 [c][NX3;H1] 仅匹配 N 连一个芳基，此规则补全
   591	    ("[c][NH1][c]",
   592	     "[c:1][NH1:2][c:3]>>[c:1]Br.[NH2:2][c:3]"),
   593	
   594	    # -- 吲哚 (Fischer 吲哚合成逆反应) --
   595	    # 匹配: 吲哚核心骨架（苯并吡咯）
   596	    # 逆反应: 吲哚 → 苯肼 + 羰基化合物
   597	    # 吲哚是 FDA 批准药物中最常见的稠杂环之一（如舒马曲坦、昂丹司琼）
   598	    # 也是 TYK2 抑制剂的核心骨架变体来源
   599	    ("c1ccc2[nH]ccc2c1",
   600	     "c1ccc2[nH]ccc2c1>>NNc1ccccc1.C=O"),
   601	
   602	    # -- 苯并呋喃 (Rap-Stoermer 逆反应) --
   603	    # 匹配: 苯并呋喃核心骨架（苯并呋喃）
   604	    # 逆反应: 苯并呋喃 → 苯酚 + α-卤代羰基
   605	    # 苯并呋喃是天然产物和药物中的常见氧杂环（如胺碘酮）
   606	    ("c1ccc2occc2c1",
   607	     "c1ccc2occc2c1>>Oc1ccccc1.BrCC=O"),
   608	
   609	    # -- 苯并噻吩 (亲电环化逆反应) --
   610	    # 匹配: 苯并噻吩核心骨架（硫代苯并呋喃）
   611	    # 逆反应: 苯并噻吩 → 硫酚 + α-卤代羰基
   612	    # 苯并噻吩在药物化学中作为苯并呋喃的硫等排体出现（如雷洛昔芬类似物）
   613	    ("c1ccc2sccc2c1",
   614	     "c1ccc2sccc2c1>>Sc1ccccc1.BrCC=O"),
   615	
   616	    # -- 四唑 (腈+叠氮 [3+2] 环加成逆反应) --
   617	    # 匹配: 1H-四唑环
   618	    # 逆反应: 四唑 → 叠氮 + 腈
   619	    # 四唑是羧酸的最常用生物电子等排体，广泛用于提高代谢稳定性
   620	    # （如氯沙坦、坎地沙坦等 ARB 类药物核心基团）
   621	    ("c1nnn[nH]1",
   622	     "c1nnn[nH]1>>[N-]=[N+]=NC.C#N"),
   623	
   624	    # -- 异噁唑 (1,3-二酮+羟胺 缩合逆反应) --
   625	    # 匹配: 异噁唑环
   626	    # 逆反应: 异噁唑 → 1,3-二羰基 + 羟胺
   627	    # 异噁唑在激酶抑制剂中作为氢键受体/供体出现，也是重要的五元杂环
   628	    ("c1cnoc1",
   629	     "c1cnoc1>>O=CC=O.NO"),
   630	]
   631	
   632	
   633	def plan_synthesis_recursive(smiles: str, max_depth: int = 3, current_depth: int = 0, visited: set = None):
   634	    """递归多步逆合成规划（H003）。
   635	
   636	    对目标分子应用单步逆合成规则，然后对得到的反应物（中间体）
   637	    递归调用逆合成规划，直到得到足够简单的起始原料或达到最大深度。
   638	
   639	    Args:
   640	        smiles: 目标分子 SMILES
   641	        max_depth: 最大递归深度
   642	        current_depth: 当前递归深度
   643	        visited: 已访问的 SMILES 集合（防止循环）
   644	
   645	    Returns:
   646	        dict: {"success": bool, "route": str, "steps": int, "trivial": bool}
   647	    """
   648	    if visited is None:
   649	        visited = set()
   650	
   651	    # 防止循环
   652	    if smiles in visited:
   653	        return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   654	    visited.add(smiles)
   655	
   656	    # 基础情况 1: 达到最大深度
   657	    if current_depth >= max_depth:
   658	        return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   659	
   660	    # 基础情况 2: 分子已经足够简单
   661	    if _is_simple_molecule(smiles):
   662	        return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   663	
   664	    mol = Chem.MolFromSmiles(smiles)
   665	    if mol is None:
   666	        return {"success": False, "error": "无效的 SMILES"}
   667	
   668	    # 尝试所有逆合成规则
   669	    for smarts_pattern, retro_smarts in RETRO_RULES:
   670	        result = _run_retro_rule(mol, smarts_pattern, retro_smarts, smiles)
   671	        if result:
   672	            reactants = result.get("reactants", [])
   673	            # 对每个反应物递归规划
   674	            sub_routes = []
   675	            all_trivial = True
   676	            for r in reactants:
   677	                sub = plan_synthesis_recursive(r, max_depth, current_depth + 1, visited.copy())
   678	                if sub.get("success"):
   679	                    sub_routes.append(sub)
   680	                    if not sub.get("trivial", False):
   681	                        all_trivial = False
   682	
   683	            # 构建完整路线：先放子路线（非平凡的），再放当前步
   684	            full_parts = []
   685	            for sub in sub_routes:
   686	                if not sub.get("trivial", False):
   687	                    full_parts.append(sub["route"])
   688	            full_parts.append(result["route"])
   689	            full_route = " | ".join(full_parts)
   690	
   691	            total_steps = result["steps"] + sum(s.get("steps", 0) for s in sub_routes)
   692	            is_trivial = all_trivial and len(reactants) == 1 and reactants[0] == smiles
   693	
   694	            return {
   695	                "success": True,
   696	                "route": full_route,
   697	                "steps": total_steps,
   698	                "trivial": is_trivial,
   699	            }
   700	
   701	    # 回退: 用 BRICS 碎片化尝试找断键
   702	    try:
   703	        frags = BRICS.BreakMol(mol)
   704	        if frags and len(frags) >= 2:
   705	            frag_smiles = []
   706	            for f in frags:
   707	                if f is None:
   708	                    continue
   709	                s = Chem.MolToSmiles(f)
   710	                if _validate_smiles(s):
   711	                    frag_smiles.append(s)
   712	            if len(frag_smiles) >= 2:
   713	                reactants = ".".join(sorted(frag_smiles)[:2])
   714	                route = _try_route(smiles, reactants)
   715	                if route:
   716	                    # 对 BRICS 碎片也尝试递归
   717	                    sub_routes = []
   718	                    all_trivial = True
   719	                    for r in frag_smiles[:2]:
   720	                        sub = plan_synthesis_recursive(r, max_depth, current_depth + 1, visited.copy())
   721	                        if sub.get("success"):
   722	                            sub_routes.append(sub)
   723	                            if not sub.get("trivial", False):
   724	                                all_trivial = False
   725	                    full_parts = []
   726	                    for sub in sub_routes:
   727	                        if not sub.get("trivial", False):
   728	                            full_parts.append(sub["route"])
   729	                    full_parts.append(route)
   730	                    full_route = " | ".join(full_parts)
   731	                    total_steps = 1 + sum(s.get("steps", 0) for s in sub_routes)
   732	                    return {
   733	                        "success": True,
   734	                        "route": full_route,
   735	                        "steps": total_steps,
   736	                        "trivial": False,
   737	                    }
   738	    except Exception:
   739	        pass
   740	
   741	    # 最终回退: 平凡路线
   742	    return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   743	
   744	
   745	def plan_synthesis_v2(smiles: str):
   746	    """使用 SMARTS 断键规则规划合成路线。
   747	
   748	    改进点（H003）：
   749	    - 引入递归多步逆合成规划（plan_synthesis_recursive）
   750	    - 对中间体继续断键，直到得到简单起始原料
   751	    - 路线格式: 步骤之间用 " | " 分隔
   752	
   753	    文献依据：
   754	    - LARC (2025): 规则覆盖率是逆合成质量的关键
   755	    - ChemCrow (2024): 工具丰富度决定 Agent 能力边界
   756	    """
   757	    return plan_synthesis_recursive(smiles, max_depth=3, current_depth=0)
   758	
   759	
   760	def score_route_quality(route_str: str, smiles: str) -> float:
   761	    """评估逆合成路线的化学合理性（H012）。
   762	
   763	    文献依据:
   764	    - LARC (Baker et al., 2025): Agent-as-a-Judge 逆合成框架，
   765	      路线质量评审是确保合成可行性的关键环节
   766	    - ChemCrow (Bran et al., 2024): 工具输出质量评估决定下游决策可靠性
   767	
   768	    评分维度:
   769	    1. 多步路线 vs 单步（多步更真实，+0.2）
   770	    2. 反应物数量（多组分反应更合理，+0.1-0.2）
   771	    3. 复杂度比（产物/反应物原子比 > 3 为可疑，-0.3）
   772	    4. 单反应物路线（除非是简单的氧化/还原/水解，-0.2）
   773	
   774	    Returns:
   775	        float: 0.0（不可行）到 1.0（非常可行）
   776	    """
   777	    if not route_str or route_str == f"{smiles}>>{smiles}":
   778	        return 0.0  # 平凡路线 = 最低质量
   779	
   780	    steps = route_str.split(" | ")
   781	    step_scores = []
   782	
   783	    for step in steps:
   784	        if " >> " not in step and ">>" not in step:
   785	            continue
   786	
   787	        # 解析反应物和产物
   788	        sep = " >> " if " >> " in step else ">>"
   789	        parts = step.split(sep, 1)
   790	        if len(parts) != 2:
   791	            continue
   792	        reactants_str, product_str = parts
   793	        reactants = [r.strip() for r in reactants_str.split(".") if r.strip()]
   794	
   795	        score = 0.5  # 默认中等
   796	
   797	        # 1. 多反应物路线更真实（大多数合成反应涉及2+组分）
   798	        if len(reactants) >= 2:
   799	            score += 0.2
   800	        elif len(reactants) == 1:
   801	            # 单反应物路线须谨慎 — 检查是否为简单官能团转化
   802	            r_mol = Chem.MolFromSmiles(reactants[0])
   803	            p_mol = Chem.MolFromSmiles(product_str)
   804	            if r_mol and p_mol:
   805	                r_atoms = r_mol.GetNumAtoms()
   806	                p_atoms = p_mol.GetNumAtoms()
   807	                if p_atoms > r_atoms + 5:
   808	                    # 单反应物生成更大产物 — 极不可能
   809	                    score -= 0.3
   810	                elif p_atoms <= r_atoms:
   811	                    # 单反应物生成等大或更小产物 — 可能是脱保护/还原/氧化
   812	                    score += 0.1
   813	
   814	        # 2. 反应物复杂度检查
   815	        r_total_atoms = 0
   816	        for r in reactants:
   817	            r_mol = Chem.MolFromSmiles(r)
   818	            if r_mol:
   819	                r_total_atoms += r_mol.GetNumAtoms()
   820	
   821	        p_mol = Chem.MolFromSmiles(product_str)
   822	        if p_mol and r_total_atoms > 0:
   823	            ratio = p_mol.GetNumAtoms() / r_total_atoms
   824	            if ratio > 3.0:
   825	                # 产物远大于反应物之和 — 不可行的单步转化
   826	                score -= 0.3
   827	            elif ratio > 2.0:
   828	                score -= 0.1
   829	
   830	        # 3. 检查是否为同一分子（无转化）
   831	        if len(reactants) == 1 and reactants[0] == product_str:
   832	            score = 0.0
   833	
   834	        step_scores.append(max(0.0, min(1.0, score)))
   835	
   836	    if not step_scores:
   837	        return 0.0
   838	
   839	    # 平均分 + 多步路线奖励
   840	    avg = sum(step_scores) / len(step_scores)
   841	    if len(step_scores) >= 2:
   842	        # 多步路线通常更接近真实合成策略
   843	        avg = min(1.0, avg + 0.15)
   844	
   845	    return round(avg, 3)
<system>1000 lines read from file starting from line 1.</system>     1	"""分子生成模块：使用 RDKit 进行基于变异的分子生成。
     2	
     3	改进点（H002）:
     4	- 引入对接引导生成（docking-guided generation）
     5	- 文献依据:
     6	  - MOOSE-Chem (Yang et al., 2025): 进化算法导航组合空间
     7	  - Coscientist (Boiko et al., 2023): 基于实验结果的迭代反思
     8	  - 综述第4.2节: Post-Execution Feedback 策略
     9	
    10	改进点（H010）:
    11	- 引入 Scaffold Hopping（骨架替换）变异算子
    12	- 使用 BRICS 分解 + BM 骨架识别 → 骨架库替换 → 侧链重连
    13	- 文献依据:
    14	  - Deep Lead Optimization (JACS 2024): 明确定义 Scaffold Hopping 为四个核心
    15	    先导化合物优化子任务之一，提出"替换核心骨架同时保留有利取代基"
    16	  - MOOSE-Chem (Yang et al., 2025): "Diverse initial population is essential
    17	    for evolutionary search to avoid premature convergence"
    18	  - 综述第3.2节: Scaffold hopping 是药物发现的核心策略之一
