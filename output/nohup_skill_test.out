   129	def dock_molecule(smiles: str, center=None, size=None, exhaustiveness=None, seed: int = 0,
   130	                  n_conformers: int = 1):
   131	    """对单个分子进行对接，返回结合能（kcal/mol）。
   132	
   133	    H029 改进：支持多构象对接增强。
   134	    当 n_conformers > 1 时，生成多个 3D 构象，对每个独立对接，
   135	    取最优结合能作为结果。这模拟了"构象系综对接"策略，
   136	    减少单构象可能错过最优结合模式的风险。
   137	
   138	    参数:
   139	        smiles: 配体 SMILES
   140	        center, size: 对接盒子参数
   141	        exhaustiveness: Vina 搜索精度
   142	        seed: 随机种子（0 = 使用默认 42）
   143	        n_conformers: 生成的构象数量（默认 1，即单构象；设为 >1 启用多构象）
   144	
   145	    返回字典包含:
   146	        - binding_energy: 最佳构象能量（负值=越好）
   147	        - poses: 构象能量列表
   148	        - success: 是否成功
   149	        - error: 失败原因
   150	        - n_conformers_tried: 实际尝试的构象数（H029 新增）
   151	        - best_conformer_idx: 最优构象索引（H029 新增）
   152	    """
   153	    receptor = prepare_receptor()
   154	
   155	    if center is None:
   156	        center = DOCKING_CENTER
   157	    if size is None:
   158	        size = DOCKING_SIZE
   159	    if exhaustiveness is None:
   160	        exhaustiveness = DOCKING_EXHAUSTIVENESS
   161	
   162	    vina_seed = seed if seed != 0 else 42
   163	
   164	    # H029: 多构象对接增强
   165	    if n_conformers > 1:
   166	        pdbqt_paths = smiles_to_pdbqt_multi_conformer(smiles, n_conformers=n_conformers)
   167	        if not pdbqt_paths:
   168	            return {"success": False, "error": "多构象配体准备失败"}
   169	
   170	        best_energy = float('inf')
   171	        best_poses = None
   172	        best_idx = -1
   173	        all_successful = []
   174	
   175	        for i, ligand_pdbqt in enumerate(pdbqt_paths):
   176	            if ligand_pdbqt is None:
   177	                continue
   178	            try:
   179	                v = Vina(sf_name="vina", seed=vina_seed, verbosity=0)
   180	                v.set_receptor(receptor)
   181	                v.set_ligand_from_file(ligand_pdbqt)
   182	                v.compute_vina_maps(center=center, box_size=size)
   183	                v.dock(exhaustiveness=exhaustiveness, n_poses=5)
   184	                energies = v.energies(n_poses=1)
   185	                energy = float(energies[0][0])
   186	                all_successful.append((i, energy))
   187	                if energy < best_energy:
   188	                    best_energy = energy
   189	                    best_poses = energies.tolist()
   190	                    best_idx = i
   191	            except Exception:
   192	                continue
   193	            finally:
   194	                if ligand_pdbqt and ligand_pdbqt.startswith(tempfile.gettempdir()):
   195	                    try:
   196	                        os.remove(ligand_pdbqt)
   197	                    except Exception:
   198	                        pass
   199	
   200	        if best_idx < 0:
   201	            return {"success": False, "error": "所有构象对接均失败"}
   202	
   203	        return {
   204	            "success": True,
   205	            "binding_energy": round(best_energy, 3),
   206	            "poses": best_poses,
   207	            "n_conformers_tried": len(all_successful),
   208	            "best_conformer_idx": best_idx,
   209	            "conformer_energies": [e for _, e in all_successful],
   210	        }
   211	
   212	    # 单构象模式（原有逻辑，保持向后兼容）
   213	    ligand_pdbqt = smiles_to_pdbqt(smiles)
   214	    if ligand_pdbqt is None:
   215	        return {"success": False, "error": "配体准备失败"}
   216	
   217	    try:
   218	        v = Vina(sf_name="vina", seed=vina_seed, verbosity=0)
   219	        v.set_receptor(receptor)
   220	        v.set_ligand_from_file(ligand_pdbqt)
   221	        v.compute_vina_maps(center=center, box_size=size)
   222	        v.dock(exhaustiveness=exhaustiveness, n_poses=5)
   223	        energies = v.energies(n_poses=1)
   224	        best_energy = float(energies[0][0])
   225	
   226	        # 清理临时文件
   227	        if ligand_pdbqt.startswith(tempfile.gettempdir()):
   228	            os.remove(ligand_pdbqt)
   229	
   230	        return {
   231	            "success": True,
   232	            "binding_energy": round(best_energy, 3),
   233	            "poses": energies.tolist(),
   234	            "n_conformers_tried": 1,
   235	            "best_conformer_idx": 0,
   236	        }
   237	    except Exception as e:
   238	        if ligand_pdbqt and ligand_pdbqt.startswith(tempfile.gettempdir()):
   239	            try:
   240	                os.remove(ligand_pdbqt)
   241	            except Exception:
   242	                pass
   243	        return {"success": False, "error": str(e)}
