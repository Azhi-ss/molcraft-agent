   246	def dock_molecule_consensus(smiles: str, center=None, size=None, exhaustiveness=None,
   247	                            n_runs: int = 3, seeds: list = None, n_conformers: int = 1):
   248	    """共识对接：多次独立对接取中位数结合能（H009）。
   249	
   250	    Coscientist 核心模式："performing experiments multiple times" —
   251	    通过不同随机种子执行 N 次独立对接，消除单次运行的随机偏差，
   252	    取中位数作为共识评分。
   253	
   254	    H029 改进：支持多构象对接，每个 seed 下取多构象最优。
   255	
   256	    返回:
   257	        - success: 是否有足够成功的对接（>=2/3）
   258	        - binding_energy: 中位数结合能（kcal/mol）
   259	        - all_energies: 所有成功对接的能量列表
   260	        - std_energy: 多次运行的能量标准差
   261	        - n_success: 成功对接次数
   262	    """
   263	    import statistics
   264	    if seeds is None:
   265	        seeds = [42, 123, 456]
   266	    seeds = seeds[:n_runs]
   267	
   268	    energies = []
   269	    success_count = 0
   270	    for seed in seeds:
   271	        result = dock_molecule(smiles, center, size, exhaustiveness, seed=seed,
   272	                              n_conformers=n_conformers)
   273	        if result.get("success"):
   274	            energies.append(result["binding_energy"])
   275	            success_count += 1
   276	
   277	    if success_count < 2:
   278	        # 不足两次成功：降级为单次结果或失败
   279	        if success_count == 1:
   280	            return {
   281	                "success": True,
   282	                "binding_energy": energies[0],
   283	                "all_energies": energies,
   284	                "std_energy": 0.0,
   285	                "n_success": 1,
   286	            }
   287	        return {"success": False, "error": f"共识对接失败: {success_count}/{n_runs}"}
   288	
   289	    med_energy = round(statistics.median(energies), 3)
   290	    std_energy = round(statistics.stdev(energies) if success_count > 1 else 0.0, 3)
   291	    return {
   292	        "success": True,
   293	        "binding_energy": med_energy,
   294	        "all_energies": energies,
   295	        "std_energy": std_energy,
   296	        "n_success": success_count,
   297	    }
   298	
   299	
   300	def batch_dock(molecules, center=None, size=None, n_conformers: int = 1):
   301	    """批量对接分子并返回结果。
   302	
   303	    H029 改进：支持 n_conformers 参数传递到 dock_molecule。
   304	    """
   305	    results = []
   306	    total_count = len(molecules)
   307	    completed_count = 0
   308	    success_count = 0
   309	    for i, mol_info in enumerate(molecules):
   310	        smiles = mol_info["smiles"]
   311	        print(f"[对接] {i+1}/{total_count}: {smiles[:40]}...")
   312	        result = dock_molecule(smiles, center, size, n_conformers=n_conformers)
   313	        result["smiles"] = smiles
   314	        result.update(mol_info)
   315	        results.append(result)
   316	        completed_count += 1
   317	        if result.get("success"):
   318	            success_count += 1
   319	        # 进度日志集成
   320	        if hasattr(sys.stdout, "log_event"):
   321	            sys.stdout.log_event(
   322	                "docking_progress",
   323	                current=completed_count,
   324	                total=total_count,
   325	                success_rate=success_count / max(completed_count, 1),
   326	            )
   327	    return results
