   107	def _run_retro_rule(mol, smarts_pattern, retro_smarts, smiles):
   108	    """通用逆合成规则执行函数。
   109	
   110	    H014 改进: 增加化学计量守恒验证（mass balance check）。
   111	    文献依据: LARC (Baker et al., 2025) — Agent-as-a-Judge 框架强调
   112	    逆合成路线必须满足化学计量守恒，原料原子数应与产物匹配。
   113	
   114	    Args:
   115	        mol: 目标分子 RDKit Mol 对象
   116	        smarts_pattern: 匹配目标分子的 SMARTS
   117	        retro_smarts: 逆合成反应的 SMARTS
   118	        smiles: 目标分子的 SMILES（用于构建路线）
   119	
   120	    Returns:
   121	        dict 或 None: 成功时返回 {"route": ..., "reactants": [...], "steps": 1}
   122	    """
   123	    patt = Chem.MolFromSmarts(smarts_pattern)
   124	    if patt is None or not mol.HasSubstructMatch(patt):
   125	        return None
   126	    rxn = AllChem.ReactionFromSmarts(retro_smarts)
   127	    if rxn is None:
   128	        return None
   129	    ps = rxn.RunReactants((mol,))
   130	    if not ps:
   131	        return None
   132	
   133	    # 目标分子的非氢原子数（用于化学计量验证）
   134	    target_n_atoms = mol.GetNumAtoms(onlyExplicit=False)
   135	    # RDKit 的 GetNumAtoms 默认不包含 H — 我们只需要重原子数
   136	    target_heavy = mol.GetNumHeavyAtoms()
   137	
   138	    # 遍历所有可能的产物集，找到第一个产生有效SMILES的
   139	    for product_set in ps:
   140	        if not product_set:
   141	            continue
   142	        if len(product_set) >= 2:
   143	            r1 = Chem.MolToSmiles(product_set[0])
   144	            r2 = Chem.MolToSmiles(product_set[1])
   145	            route = _try_route(smiles, r1, r2)
   146	            reactants = [r1, r2]
   147	        else:
   148	            r1 = Chem.MolToSmiles(product_set[0])
   149	            route = _try_route(smiles, r1)
   150	            reactants = [r1]
   151	
   152	        if route:
   153	            # H014: 化学计量守恒检查
   154	            # 验证反应物重原子数总和与目标分子是否在合理范围内
   155	            # 若规则只匹配部分分子（如仅匹配核心骨架而丢失取代基），
   156	            # 产物重原子数/原料重原子数会显著偏离 1.0
   157	            try:
   158	                reactant_heavy = 0
   159	                for r_smi in reactants:
   160	                    r_mol = Chem.MolFromSmiles(r_smi)
   161	                    if r_mol:
   162	                        reactant_heavy += r_mol.GetNumHeavyAtoms()
   163	                if reactant_heavy > 0:
   164	                    ratio = target_heavy / reactant_heavy
   165	                    # 允许 ±30% 容差（考虑脱保护基、缩合失水等）
   166	                    # H014 调优: 0.7-1.3 — 验证显示 0.5-1.5 过宽
   167	                    #   例: 取代喹啉(17atoms) / 无取代原料(12atoms) = 1.42 > 1.3 ✓ 拒绝
   168	                    if ratio < 0.7 or ratio > 1.3:
   169	                        # 原子不守恒 — 拒绝此条规则，尝试下一条
   170	                        continue
   171	            except Exception:
   172	                # 解析失败时不拒绝，保留原有行为
   173	                pass
   174	
   175	            return {"success": True, "route": route, "reactants": reactants, "steps": 1}
   176	
   177	    return None
