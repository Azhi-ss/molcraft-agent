   639	def plan_synthesis_v2(smiles: str):
   640	    """使用 SMARTS 断键规则规划合成路线。
   641	
   642	    改进点（H003）：
   643	    - 引入递归多步逆合成规划（plan_synthesis_recursive）
   644	    - 对中间体继续断键，直到得到简单起始原料
   645	    - 路线格式: 步骤之间用 " | " 分隔
   646	
   647	    文献依据：
   648	    - LARC (2025): 规则覆盖率是逆合成质量的关键
   649	    - ChemCrow (2024): 工具丰富度决定 Agent 能力边界
   650	    """
   651	    return plan_synthesis_recursive(smiles, max_depth=3, current_depth=0)
