    87	def _try_route(smiles: str, r1: str, r2: str = None) -> str:
    88	    """尝试构建合成路线，验证所有反应物 SMILES 并添加副产物确保原子平衡。
    89	
    90	    H019 修复: Suzuki 等反应需要在产物侧添加副产物才能通过原子平衡检查。
    91	    """
    92	    if not _validate_smiles(r1):
    93	        return None
    94	    if r2 is not None and not _validate_smiles(r2):
    95	        return None
    96	
    97	    reactants = [r1] if r2 is None else [r1, r2]
    98	    byproducts = _add_byproducts_for_balance(smiles, reactants)
    99	
   100	    # 构建完整的产物侧（主产物 + 副产物）
   101	    product_part = ".".join([smiles] + byproducts)
   102	    reactant_part = ".".join(reactants)
   103	
   104	    return f"{reactant_part}>>{product_part}"
