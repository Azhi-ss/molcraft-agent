   343	def _generate_diffusion(n_molecules, log_lines):
   344	    """调用 PocketXMol 扩散模型 HTTP API 生成口袋感知分子。
   345	
   346	    Returns:
   347	        list[dict] | None: 生成的分子列表（格式与 generate_molecules 兼容），失败返回 None
   348	    """
   349	    import urllib.request
   350	    import urllib.error
   351	    from src import config as _config
   352	
   353	    api_url = _config.DIFFUSION_API_URL
   354	    if not api_url:
   355	        log("DIFFUSION_API_URL 未配置，跳过扩散模型生成", log_lines)
   356	        return None
   357	
   358	    try:
   359	        pdb_path = _config.TARGET_PDB
   360	        if not os.path.exists(pdb_path):
   361	            log(f"PDB 文件不存在: {pdb_path}", log_lines)
   362	            return None
   363	        pdb_content = open(pdb_path).read()
   364	
   365	        request_body = json.dumps({
   366	            "pdb_content": pdb_content,
   367	            "n_molecules": n_molecules,
   368	            "pocket_center": _config.DOCKING_CENTER,
   369	            "pocket_radius": max(_config.DOCKING_SIZE) / 2.0 if _config.DOCKING_SIZE else 15.0,
   370	        }, ensure_ascii=False).encode("utf-8")
   371	
   372	        url = f"{api_url.rstrip('/')}/generate"
   373	        req = urllib.request.Request(
   374	            url, data=request_body,
   375	            headers={"Content-Type": "application/json"},
   376	            method="POST",
   377	        )
   378	
   379	        log(f"调用扩散模型 API: {url} (n={n_molecules})", log_lines)
   380	        with urllib.request.urlopen(req, timeout=_config.DIFFUSION_TIMEOUT) as resp:
   381	            result = json.loads(resp.read().decode("utf-8"))
   382	
   383	        molecules = result.get("molecules", [])
   384	        gen_time = result.get("generation_time_seconds", 0)
   385	        log(f"扩散模型返回 {len(molecules)} 个分子 (耗时 {gen_time:.0f}s)", log_lines)
   386	
   387	        # 转换为与 generate_molecules 兼容的格式
   388	        converted = []
   389	        for m in molecules:
   390	            smiles = m.get("smiles", "")
   391	            if not smiles:
   392	                continue
   393	            mol = Chem.MolFromSmiles(smiles)
   394	            if mol is None or len(Chem.GetMolFrags(mol)) > 1:
   395	                continue
   396	            converted.append({
   397	                "smiles": smiles,
   398	                "qed": m.get("qed"),
   399	                "mw": m.get("mw"),
   400	                "logp": m.get("logp"),
   401	                "sa_score": m.get("sa_score"),
   402	            })
   403	
   404	        return converted if converted else None
   405	
   406	    except urllib.error.URLError as e:
   407	        log(f"扩散模型 API 连接失败: {e}", log_lines)
   408	        return None
   409	    except Exception as e:
   410	        log(f"扩散模型生成异常: {e}", log_lines)
   411	        return None
   412	
