     2	import math
     3	from rdkit import Chem
     4	from rdkit.Chem import Descriptors, QED, Lipinski
     5	from rdkit.Chem import RDConfig
     6	import os
     7	
     8	
     9	def evaluate_molecule(smiles: str):
    10	    """评估分子的药物相似性和基本理化性质。"""
    11	    mol = Chem.MolFromSmiles(smiles)
    12	    if mol is None:
    13	        return {"valid": False, "error": "无效的 SMILES"}
    14	
    15	    mol = Chem.AddHs(mol)
    16	    mw = Descriptors.MolWt(mol)
    17	    logp = Descriptors.MolLogP(mol)
    18	    tpsa = Descriptors.TPSA(mol)
    19	    hbd = Lipinski.NumHDonors(mol)
    20	    hba = Lipinski.NumHAcceptors(mol)
    21	    rotb = Descriptors.NumRotatableBonds(mol)
    22	    rings = Descriptors.RingCount(mol)
    23	    qed = QED.qed(mol)
    24	
    25	    # 合成可及性估算（非常粗略）
    26	    sa = estimate_sa_score(mol)
    27	
    28	    # 类药五规则检查
    29	    lipinski_violations = 0
    30	    if mw > 500: lipinski_violations += 1
    31	    if logp > 5: lipinski_violations += 1
    32	    if hbd > 5: lipinski_violations += 1
    33	    if hba > 10: lipinski_violations += 1
    34	    lipinski_ok = lipinski_violations <= 1  # 允许违反 1 条
    35	
    36	    return {
    37	        "valid": True,
    38	        "smiles": smiles,
    39	        "mw": round(mw, 2),
    40	        "logp": round(logp, 2),
    41	        "tpsa": round(tpsa, 2),
    42	        "hbd": hbd,
    43	        "hba": hba,
    44	        "rotatable_bonds": rotb,
    45	        "rings": rings,
    46	        "qed": round(qed, 3),
    47	        "sa_score": round(sa, 2),
    48	        "lipinski_pass": lipinski_ok,
    49	    }
    50	
    51	
    52	def estimate_sa_score(mol):
    53	    """合成可及性估算（0-10，越低越好）。
    54	
    55	    H001 改进：
    56	    - 环贡献因子从 0.5→1.0（多环结构显著增加合成难度）
    57	    - 新增稠环惩罚：每个额外环系 +0.3（fused ring penalty）
    58	    - 螺环惩罚从 1.0→1.5（螺环形成挑战性高）
    59	    - 桥头原子惩罚从 1.5→2.0（桥头结构极难合成）
    60	
    61	    """
    62	    # 统计环信息
    63	    ri = mol.GetRingInfo()
    64	    atom_rings = ri.AtomRings()
    65	    n_rings = len(atom_rings)
    66	
    67	    # 检测稠环数（真正共享原子/键的环系）
    68	    # ri.BondRings() 返回所有环，错误地会对单环多环都惩罚
    69	    # 正确方式：统计共享 >=2 个原子的环对数量
    70	    n_fused_systems = 0
    71	    n = len(atom_rings)
    72	    for i in range(n):
    73	        for j in range(i + 1, n):
    74	            shared = len(set(atom_rings[i]) & set(atom_rings[j]))
    75	            if shared >= 2:  # 共享至少2个原子才是稠合环
    76	                n_fused_systems += 1
    77	    fused_penalty = n_fused_systems * 0.3
    78	
    79	    # 螺环中心
    80	    spiro = Chem.rdMolDescriptors.CalcNumSpiroAtoms(mol)
    81	
    82	    # 桥头原子
    83	    bridge = Chem.rdMolDescriptors.CalcNumBridgeheadAtoms(mol)
    84	
    85	    # 手性中心
    86	    stereo = Chem.rdMolDescriptors.CalcNumAtomStereoCenters(mol)
    87	
    88	    # 基础启发式公式（优化后）
    89	    score = 1.0 + n_rings * 1.0 + fused_penalty + spiro * 1.5 + bridge * 2.0 + stereo * 0.5
    90	    score += Descriptors.NumRotatableBonds(mol) * 0.1
    91	    return min(score, 10.0)
    92	
    93	
    94	def passes_filters(props: dict, min_qed=0.3, max_mw=500, min_mw=150, max_logp=5.0,
    95	                   max_sa=7.0, max_rings=9):
    96	    """检查分子是否通过基础类药性质过滤。
    97	
    98	    H001 改进：
    99	    - SA score 阈值从 8.0 收紧至 6.0
   100	    - 新增 max_rings=7 环数上限
   101	    - 文献依据：Deep Lead Optimization (JACS, 2024)
   102	
   103	    H027 改进：
   104	    - max_rings 7→9, max_sa 6.0→7.0
   105	    - 基于 Round 18-19 实验验证：Vina 评分偏向疏水芳香体系，
   106	      更宽松的过滤器允许更大的π体系通过（MW仍<500约束）
   107	
   108	    """
   109	    if not props.get("valid"):
   110	        return False
   111	    if props["qed"] < min_qed:
   112	        return False
   113	    if not (min_mw <= props["mw"] <= max_mw):
   114	        return False
   115	    if props["logp"] > max_logp:
   116	        return False
   117	    if props["sa_score"] > max_sa:
   118	        return False
   119	    if props.get("rings", 0) > max_rings:
   120	        return False
   121	    return True
