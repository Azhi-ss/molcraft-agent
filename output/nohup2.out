   222	# ======================================================================
   223	# 逆合成规则库 — 按反应类型分组，共 35+ 条规则
   224	# 设计原则：
   225	#   1. 优先匹配更具体的结构（放在前面）
   226	#   2. 覆盖常见药物化学键连方式
   227	#   3. 反应物应为商业可得的简单分子
   228	# ======================================================================
   229	
   230	RETRO_RULES = [
   231	    # ============================== H012 新增规则 ==============================
   232	    # 文献依据: LARC (Baker et al., 2025) — 规则覆盖率决定逆合成质量;
   233	    # ChemCrow (Bran et al., 2024) — 工具/库的丰富度直接决定 Agent 能力边界
   234	    
   235	    # -- 喹啉/异喹啉合成（先于通用吡啶规则匹配）--
   236	    # Friedländer 喹啉合成逆反应: 喹啉 → 邻氨基苯甲醛 + 酮
   237	    ("c1ccc2c(c1)cccn2", "c1ccc2c(c1)cccn2>>Nc1ccccc1C=O.CC=O"),
   238	    # 异喹啉 → Pictet-Spengler 逆反应
   239	    ("c1ccc2c(c1)ccnc2", "c1ccc2c(c1)ccnc2>>NCCc1ccccc1.C=O"),
   240	    
   241	    # -- 喹唑啉合成 --
   242	    # 喹唑啉 → 邻氨基苯甲酰胺 + 甲酸
   243	    ("c1ccc2c(c1)ncnc2", "c1ccc2c(c1)ncnc2>>Nc1ccccc1C(=O)N.C=O"),
   244	    
   245	    # -- 1,2,3-三唑 (Click Chemistry) --
   246	    # CuAAC 逆反应: 三唑 → 叠氮 + 炔
   247	    ("c1cnnn1", "c1cnnn1>>[N-]=[N+]=NC.C#C"),
   248	    
   249	    # -- 肼/联氨类 --
   250	    # 肼 → 重氮盐还原
   251	    ("[NH2][NH2]", "[NH2:1][NH2:2]>>[NH2:1]Cl.[NH2:2]"),
   252	    
   253	    # ============================== 原有规则 ==============================
   254	    # ------------------- 联芳基 C-C 键 (H012) -------------------
   255	    # Suzuki 逆反应: Ar-Ar' → Ar-Br + (HO)2B-Ar'
   256	    # 文献依据: Coscientist (Boiko et al., 2023) — Suzuki coupling 是经典 C-C 键形成;
   257	    # LARC (Baker et al., 2025) — 规则覆盖率决定逆合成质量
   258	    ("[c;R][c;R]", "[c:1][c:2]>>[c:1]Br.[c:2]B(O)O"),
   259	    
   260	    # ------------------- 磺酰胺类 -------------------
   261	    ("[S](=[O])(=[O])[N;!H0]", "[c:1][S](=[O])(=[O])[N:2]>>[c:1][S](=[O])(=[O])Cl.[N:2]"),
   262	    ("[S](=[O])(=[O])[N;H0]", "[c:1][S](=[O])(=[O])[N:2]>>[c:1][S](=[O])(=[O])Cl.[N:2]"),
   263	    
   264	    # ------------------- 酰胺类 -------------------
   265	    ("[C](=[O])[N;!H0]", "[C:1](=[O])[N:2]>>[C:1](=O)O.[N:2]"),
   266	    ("[C](=[O])[N;H0]", "[C:1](=[O])[N:2]>>[C:1](=O)O.[N:2]"),
   267	    
   268	    # ------------------- 酯类 -------------------
   269	    ("[C](=[O])O[!H0]", "[C:1](=[O])O[!H0:2]>>[C:1](=O)O.[O:2]"),
   270	    
   271	    # ------------------- 硫酯类 -------------------
   272	    ("[C](=[O])S[!H0]", "[C:1](=[O])S:2>>[C:1](=O)O.[S:2]"),
   273	    
   274	    # ------------------- 芳基醚 / 烷基醚 -------------------
   275	    ("[c]O[#6;!c]", "[c:1]O[#6;!c:2]>>[c:1]O.[C:2]Cl"),
   276	    ("[#6;!c]O[#6;!c]", "[#6;!c:1]O[#6;!c:2]>>[#6;!c:1]O.[#6;!c:2]Cl"),
   277	    
   278	    # ------------------- 胺类 -------------------
   279	    # 仲胺 — 还原胺化逆反应
   280	    ("[NX3;H1;!$(NC=O);!$(NS(=O)=O)]", "[C:1][N;H1:2][C:3]>>[C:1][N;H2:2].[C:3]=O"),
   281	    # 叔胺 — 烷基化逆反应
   282	    ("[NX3;H0;!$(NC=O);!$(NS(=O)=O)]", "[C:1][N:2][C:3]>>[C:1][N:2].[C:3]Cl"),
   283	    # 芳基仲胺 — Buchwald-Hartwig 简化
   284	    ("[c][NX3;H1]", "[c:1][N:2]>>[c:1]Br.[N:2]"),
   285	    # 芳基叔胺
   286	    ("[c][NX3;H0]", "[c:1][N:2]>>[c:1]Br.[N:2]"),
   287	    
   288	    # ------------------- 脲类 -------------------
   289	    ("[N;!H0]C(=O)[N;!H0]", "[N:1]C(=O)[N:2]>>[N:1].O=C=N[N:2]"),
   290	    
   291	    # ------------------- 氨基甲酸酯 -------------------
   292	    ("[N;!H0]C(=O)O", "[N:1]C(=O)O>>[N:1].O=C=O"),
   293	    
   294	    # ------------------- 硝基还原 -------------------
   295	    ("[N+](=O)[O-]", "[N+](=O)[O-]>>N"),
   296	    
   297	    # ------------------- 卤代芳烃 -------------------
   298	    # 芳基氟 — 亲核芳香取代逆反应
   299	    ("[c]F", "[c:1]F>>[c:1]Cl.F"),
   300	    # 芳基氯
   301	    ("[c]Cl", "[c:1]Cl>>[c:1]O.Cl"),
   302	    # 芳基溴
   303	    ("[c]Br", "[c:1]Br>>[c:1]O.Br"),
   304	    # 芳基碘
   305	    ("[c]I", "[c:1]I>>[c:1]O.I"),
   306	    
   307	    # ------------------- 酮 / 醛 -------------------
   308	    # 芳基酮 — Friedel-Crafts 酰化逆反应
   309	    ("[c]C(=O)[C;!c]", "[c:1]C(=O)[C:2]>>[c:1].[C:2]C(=O)Cl"),
   310	    # 二芳基酮
   311	    ("[c]C(=O)[c]", "[c:1]C(=O)[c:2]>>[c:1].[c:2]C(=O)Cl"),
   312	    # 醛
   313	    ("[CX3H1](=O)", "[C:1](=O)>>[C:1]O"),
   314	    
   315	    # ------------------- 醇类 -------------------
   316	    # 苄醇 — 还原逆反应
   317	    ("[c]C[OH]", "[c:1]C[OH]>>[c:1]C(=O)O"),
   318	    # 普通醇 — 水解逆反应（酯/环氧）
   319	    ("[C;!c][OH]", "[C:1][OH]>>[C:1]Cl.O"),
   320	    
   321	    # ------------------- 腈类 -------------------
   322	    ("[C]#N", "[C:1]#N>>[C:1](=O)O.N"),
   323	    
   324	    # ------------------- 杂环合成 -------------------
   325	    # 噻唑 — Hantzsch 噻唑合成逆反应
   326	    ("c1ncsc1", "c1ncsc1>>N.CS.C=O"),
   327	    # 咪唑
   328	    ("c1[nH]cnc1", "c1[nH]cnc1>>N.C=O.N"),
   329	    # 噁唑
   330	    ("c1ncoc1", "c1ncoc1>>N.C=O.O"),
   331	    # 吡啶（H012 修复：R1 限制仅匹配孤立吡啶环，排除喹啉/异喹啉等稠环体系）
   332	    # 文献: JACS 2024 — 逆合成应反映真实化学转化，单步合成复杂稠环不可行
   333	    ("[c;R1]1[c;R1][c;R1][n;R1][c;R1][c;R1]1", "c1ccncc1>>O=C1CCCC(=O)C1.N"),
   334	    # 嘧啶
   335	    ("c1cncnc1", "c1cncnc1>>N.C=O.N.C=O"),
   336	    
   337	    # ============================== H015 新增规则 ==============================
   338	    # 文献依据: LARC (Baker et al., 2025) — 规则覆盖率决定逆合成质量;
   339	    # Deep Lead Optimization (JACS 2024) — 稠环/桥环体系需要专门的断键策略
   340	    # 设计原则: 覆盖当前缺失的饱和含氮杂环骨架（THIQ、吲哚啉、饱和双环胺等）
   341	    
   342	    # -- 四氢异喹啉 (THIQ) 逆 Pictet-Spengler 反应 --
   343	    # 断裂苄位 C-N 键: THIQ → 苯乙胺 + 醛/酮
   344	    ("c1ccc2c(c1)CCNC2", "c1ccc2c(c1)CCNC2>>NCCc1ccccc1.C=O"),
   345	    
   346	    # -- 吲哚啉 (二氢吲哚) 逆还原环化 --
   347	    # 断裂 C-N 键开环: 吲哚啉 → 邻乙基苯胺
   348	    ("c1ccc2c(c1)CCN2", "c1ccc2c(c1)CCN2>>NCCc1ccccc1"),
   349	    
   350	    # -- 四氢喹啉 逆还原环化 --
   351	    # 1,2,3,4-四氢喹啉 → N-丙基苯胺
   352	    ("c1ccc2c(c1)CCCN2", "c1ccc2c(c1)CCCN2>>NCCCc1ccccc1"),
   353	    
   354	    # -- 饱和环内二级胺 C-N 键断裂 (逆还原胺化) --
   355	    # 只匹配饱和环体系内的 sp3C-sp3N 键，排除酰胺/磺酰胺/芳香体系
   356	    # 产物: C 转羰基 + 游离胺，原子数 +1 (O)，比例在 0.7-1.3 范围内
   357	    ("[C;R;!a;!$(C=*);!$(C#*)][N;R;!a;!$(N[a]);!$(NC=O);!$(NS(=O)=O)]",
   358	     "[C:1][N:2]>>[C:1]=O.[N:2]"),
   359	    
   360	    # -- 苄位 C-N 键在饱和环中 (retro-Pictet-Spengler 变体) --
   361	    # 更精确匹配: 芳环邻接的饱和 C-N 键
   362	    ("[c;R][C;R;!a][N;R;!a;!$(NC=O)]",
   363	     "[c:1][C:2][N:3]>>[c:1][C:2]=O.[N:3]"),
   364	    
   365	    # -- 苯并氮杂环 (benzazepine) 断键 --
   366	    # 7 元含氮杂环与苯稠合 → 逆 Bischler-Napieralski
   367	    ("c1ccc2c(c1)CCCNC2", "c1ccc2c(c1)CCCNC2>>NCCCCc1ccccc1.C=O"),
   368	    
   369	    # ------------------- 缩合反应 -------------------
   370	    # 烯烃 — Wittig / 羟醛缩合逆反应
   371	    ("[C]=[C]", "[C:1]=[C:2]>>[C:1]C=O.[C:2]P"),
   372	    # 亚胺 / 席夫碱
   373	    ("[C]=[N]", "[C:1]=[N:2]>>[C:1]=O.[N:2]"),
   374	    
   375	    # ------------------- 硫醚 / 硫醇 -------------------
   376	    ("[c]S[!H0]", "[c:1][S:2]>>[c:1]Br.[S:2]"),
   377	    ("[C;!c]S[C;!c]", "[C:1][S:2]>>[C:1]Cl.[S:2]"),
   378	    
   379	    # ------------------- 重氮 / 叠氮 -------------------
   380	    ("[N]=[N]", "[N:1]=[N:2]>>[N:1].[N:2]"),
   381	    
   382	    # ------------------- 酰亚胺 -------------------
   383	    ("[C](=O)[N][C](=O)", "[C:1](=O)[N:2][C:3](=O)>>[C:1](=O)O.[N:2].[C:3](=O)O"),
   384	    
   385	    # ------------------- 肟 / 腙 -------------------
   386	    ("[C]=[N][OH]", "[C:1]=[N:2][OH]>>[C:1]=O.[N:2]O"),
   387	    ("[C]=[N][N]", "[C:1]=[N:2][N:3]>>[C:1]=O.[N:2][N:3]"),
   388	    
   389	    # ------------------- 碳酸酯 -------------------
   390	    ("O=C(OC)OC", "O=C(OC)OC>>CO.O=C=O"),
   391	    
   392	    # ------------------- 特殊稠环骨架 -------------------
   393	    # 5,10-二氢吩嗪类 — 逆合成到 2,2'-二氨基联苯
   394	    ("c1ccc2c(c1)CNc1ccccc1N2", "c1ccc2c(c1)CNc1ccccc1N2>>Nc1ccccc1-c1ccccc1N"),
   395	
   396	    # ============================== H016 新增规则 ==============================
   397	    # 文献依据:
   398	    #   - Deep Lead Optimization (JACS 2024): 稠环体系需要专门断键策略,
   399	    #     Diels-Alder 环加成是合成六元碳环/桥环的核心反应
   400	    #   - LARC (Baker et al., 2025): 规则覆盖率决定逆合成质量
   401	    #   - 综述第3.2节: 周环反应是药物化学关键转化
   402	    # 设计原则:
   403	    #   - ;R 确保在环内，;!a 排除芳香环
   404	    #   - 产物原子映射保证取代基正确传递
   405	    #   - 原子守恒（6重原子 → 4+2=6），通过 H014 mass balance 验证
   406	
   407	    # -- 环己烯 Diels-Alder 逆反应（通用型）--
   408	    # 六元碳环单烯烃 → 1,3-丁二烯片段 + 烯烃片段
   409	    # 这是最经典的 [4+2] 环加成逆反应，适用于:
   410	    #   简单环己烯、取代环己烯、四氢邻苯二甲酰亚胺类等
   411	    # 验证: tetrahydrophthalimide → butadiene + maleimide ✓
   412	    ("[C;R;!a]1=[C;R;!a][C;R;!a][C;R;!a][C;R;!a][C;R;!a]1",
   413	     "[C:1]1=[C:2][C:3][C:4][C:5][C:6]1>>[C:1]=[C:2][C:3]=[C:4].[C:5]=[C:6]"),
   414	
   415	    # -- 二氢吡喃/二氢噻喃 Hetero-Diels-Alder 逆反应（变体A）--
   416	    # 双键紧邻杂原子: O-C=C-C-C-C → O=C-C=C + C=C
   417	    # 适用于: 3,4-二氢-2H-吡喃（C1COC=CC1）、二氢噻喃类似物
   418	    ("[O,S;R]1[C;R;!a]=[C;R;!a][C;R;!a][C;R;!a][C;R;!a]1",
   419	     "[O,S:1]1[C:2]=[C:3][C:4][C:5][C:6]1>>[O,S:1]=[C:2][C:3]=[C:4].[C:5]=[C:6]"),
   420	
   421	    # -- 二氢吡喃/二氢噻喃 Hetero-Diels-Alder 逆反应（变体B）--
   422	    # 双键远离杂原子: O-C-C=C-C-C → O-C=C-C=C + C=C
   423	    # 适用于双键在另一端位置的二氢吡喃变体
   424	    ("[O,S;R]1[C;R;!a][C;R;!a][C;R;!a]=[C;R;!a][C;R;!a]1",
   425	     "[O,S:1]1[C:2][C:3][C:4]=[C:5][C:6]1>>[O,S:1][C:2]=[C:3][C:4]=[C:5].[C:6]"),
   426	
   427	    # ============================== H017 新增规则 ==============================
   428	    # 文献依据:
   429	    #   - LARC (Baker et al., 2025): 规则覆盖率决定逆合成质量,
   430	    #     内酯/环氧/吡唑/sp3C-sp3C 等骨架的断键规则是当前明显缺口
   431	    #   - Deep Lead Optimization (JACS 2024): 稠环/杂环体系需专门断键策略
   432	    #   - Coscientist (Boiko et al., 2023): 逆合成模板库是合成质量的基础
   433	
   434	    # -- 内酯（Lactone）开环: 环内酯逆水解为羟酸 --
   435	    # 匹配: 环内的 -C(=O)-O-C- 子结构
   436	    # 逆反应: 水解开环 → 末端羟基 + 末端羧酸
   437	    # 适用范围: γ-丁内酯、δ-戊内酯、大环内酯等
   438	    ("[C;R](=[O])[O;R]",
   439	     "[C:1](=[O])[O:2]>>[C:1](=O)O.[O:2]"),
   440	
   441	    # -- 环氧化物（Epoxide）开环: 三员环氧逆水解为 1,2-二醇 --
   442	    # 匹配: C1OC1 三员环氧环（两个碳共用一个氧）
   443	    # 逆反应: 酸催化开环 → 反式 1,2-二醇
   444	    ("C1OC1",
   445	     "C1OC1>>CCO"),
   446	
   447	    # -- 吡唑（Pyrazole）N-N 键断裂 --
   448	    # 匹配: 五元芳环中含两个相邻氮原子
   449	    # 逆反应: 吡唑 → 1,3-二羰基 + 肼（Knorr 吡唑合成逆反应）
   450	    # 吡唑骨架是激酶抑制剂（如 TYK2）的核心结构
   451	    ("c1cn[nH]c1",
   452	     "c1cn[nH]c1>>O=CC=O.NN"),
   453	
   454	    # -- sp3-sp3 C-C 键断裂（逆 Wurtz 偶联）--
   455	    # 匹配: 非环烷基链中的 C-C 单键（至少一侧为 sp3 C）
   456	    # 逆反应: C-C → C-Br + C-Cl（Wurtz 偶联逆反应）
   457	    # 适用于: 长烷基链断键、非芳环体系的 C-C 键切割
   458	    # 注意: ;!R 确保不匹配环内 C-C（优先由其他专门规则处理）
   459	    # H017-fix: MgBr → Cl（Grignard 试剂不可表示为有效 SMILES）
   460	    ("[C;!R;!$(C=*);!$(C#*)][C;!R;!$(C=*);!$(C#*)]",
   461	     "[C:1][C:2]>>[C:1]Br.[C:2]Cl"),
   462	
   463	    # -- 环醚开环（THF/THP 逆 Williamson 醚合成）--
   464	    # 匹配: 四氢呋喃/四氢吡喃/氧杂环丁烷/二氧戊环等饱和环醚中的 C-O-C
   465	    # 逆反应: 环醚开环 → 卤代醇
   466	    # 适用于: THF、THP、1,4-二氧六环、氧杂环丁烷等
   467	    ("[C;R;!a][O;R;!a]",
   468	     "[C:1][O:2]>>[C:1]Br.[O:2]"),
   469	
   470	    # ============================== H020 新增规则 ==============================
   471	    # 文献依据:
   472	    #   - LARC (Baker et al., 2025): 规则覆盖率决定逆合成质量
   473	    #   - ChemCrow (Bran et al., 2024): 工具/规则库丰富度决定 Agent 能力边界
   474	    #   - JACS 2024: BRICS 16种可断裂键需要配套的逆合成规则
   475	    # 设计原则:
   476	    #   - 覆盖药物化学最高频缺失的杂环骨架（吲哚、苯并呋喃、四唑等）
   477	    #   - 每条规则对应真实的命名反应，确保化学合理性
   478	    #   - 放在通用规则之前，确保优先匹配更具体的结构
   479	
   480	    # -- 二芳基胺 (Buchwald-Hartwig 双芳基化逆反应) --
   481	    # 匹配: 二级芳胺 NH 连接两个芳香碳原子
   482	    # 逆反应: 断裂一个 C-N 键 → Ar-Br + H2N-Ar
   483	    # 这是药物化学中极常见的结构（如联苯胺类、二苯胺类）
   484	    # 现有 Buchwald 规则 [c][NX3;H1] 仅匹配 N 连一个芳基，此规则补全
   485	    ("[c][NH1][c]",
   486	     "[c:1][NH1:2][c:3]>>[c:1]Br.[NH2:2][c:3]"),
   487	
   488	    # -- 吲哚 (Fischer 吲哚合成逆反应) --
   489	    # 匹配: 吲哚核心骨架（苯并吡咯）
   490	    # 逆反应: 吲哚 → 苯肼 + 羰基化合物
   491	    # 吲哚是 FDA 批准药物中最常见的稠杂环之一（如舒马曲坦、昂丹司琼）
   492	    # 也是 TYK2 抑制剂的核心骨架变体来源
   493	    ("c1ccc2[nH]ccc2c1",
   494	     "c1ccc2[nH]ccc2c1>>NNc1ccccc1.C=O"),
   495	
   496	    # -- 苯并呋喃 (Rap-Stoermer 逆反应) --
   497	    # 匹配: 苯并呋喃核心骨架（苯并呋喃）
   498	    # 逆反应: 苯并呋喃 → 苯酚 + α-卤代羰基
   499	    # 苯并呋喃是天然产物和药物中的常见氧杂环（如胺碘酮）
   500	    ("c1ccc2occc2c1",
   501	     "c1ccc2occc2c1>>Oc1ccccc1.BrCC=O"),
   502	
   503	    # -- 苯并噻吩 (亲电环化逆反应) --
   504	    # 匹配: 苯并噻吩核心骨架（硫代苯并呋喃）
   505	    # 逆反应: 苯并噻吩 → 硫酚 + α-卤代羰基
   506	    # 苯并噻吩在药物化学中作为苯并呋喃的硫等排体出现（如雷洛昔芬类似物）
   507	    ("c1ccc2sccc2c1",
   508	     "c1ccc2sccc2c1>>Sc1ccccc1.BrCC=O"),
   509	
   510	    # -- 四唑 (腈+叠氮 [3+2] 环加成逆反应) --
   511	    # 匹配: 1H-四唑环
   512	    # 逆反应: 四唑 → 叠氮 + 腈
   513	    # 四唑是羧酸的最常用生物电子等排体，广泛用于提高代谢稳定性
   514	    # （如氯沙坦、坎地沙坦等 ARB 类药物核心基团）
   515	    ("c1nnn[nH]1",
   516	     "c1nnn[nH]1>>[N-]=[N+]=NC.C#N"),
   517	
   518	    # -- 异噁唑 (1,3-二酮+羟胺 缩合逆反应) --
   519	    # 匹配: 异噁唑环
   520	    # 逆反应: 异噁唑 → 1,3-二羰基 + 羟胺
   521	    # 异噁唑在激酶抑制剂中作为氢键受体/供体出现，也是重要的五元杂环
   522	    ("c1cnoc1",
   523	     "c1cnoc1>>O=CC=O.NO"),
   524	]
   525	
   526	
   527	def plan_synthesis_recursive(smiles: str, max_depth: int = 3, current_depth: int = 0, visited: set = None):
   528	    """递归多步逆合成规划（H003）。
   529	
   530	    对目标分子应用单步逆合成规则，然后对得到的反应物（中间体）
   531	    递归调用逆合成规划，直到得到足够简单的起始原料或达到最大深度。
   532	
   533	    Args:
   534	        smiles: 目标分子 SMILES
   535	        max_depth: 最大递归深度
   536	        current_depth: 当前递归深度
   537	        visited: 已访问的 SMILES 集合（防止循环）
   538	
   539	    Returns:
   540	        dict: {"success": bool, "route": str, "steps": int, "trivial": bool}
   541	    """
   542	    if visited is None:
   543	        visited = set()
   544	
   545	    # 防止循环
   546	    if smiles in visited:
   547	        return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   548	    visited.add(smiles)
   549	
   550	    # 基础情况 1: 达到最大深度
   551	    if current_depth >= max_depth:
   552	        return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   553	
   554	    # 基础情况 2: 分子已经足够简单
   555	    if _is_simple_molecule(smiles):
   556	        return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
   557	
   558	    mol = Chem.MolFromSmiles(smiles)
   559	    if mol is None:
   560	        return {"success": False, "error": "无效的 SMILES"}
   561	
   562	    # 尝试所有逆合成规则
   563	    for smarts_pattern, retro_smarts in RETRO_RULES:
   564	        result = _run_retro_rule(mol, smarts_pattern, retro_smarts, smiles)
   565	        if result:
   566	            reactants = result.get("reactants", [])
   567	            # 对每个反应物递归规划
   568	            sub_routes = []
   569	            all_trivial = True
   570	            for r in reactants:
   571	                sub = plan_synthesis_recursive(r, max_depth, current_depth + 1, visited.copy())
   572	                if sub.get("success"):
   573	                    sub_routes.append(sub)
   574	                    if not sub.get("trivial", False):
   575	                        all_trivial = False
   576	
   577	            # 构建完整路线：先放子路线（非平凡的），再放当前步
   578	            full_parts = []
   579	            for sub in sub_routes:
   580	                if not sub.get("trivial", False):
   581	                    full_parts.append(sub["route"])
   582	            full_parts.append(result["route"])
   583	            full_route = " | ".join(full_parts)
   584	
   585	            total_steps = result["steps"] + sum(s.get("steps", 0) for s in sub_routes)
   586	            is_trivial = all_trivial and len(reactants) == 1 and reactants[0] == smiles
   587	
   588	            return {
   589	                "success": True,
   590	                "route": full_route,
   591	                "steps": total_steps,
   592	                "trivial": is_trivial,
   593	            }
   594	
   595	    # 回退: 用 BRICS 碎片化尝试找断键
   596	    try:
   597	        frags = BRICS.BreakMol(mol)
   598	        if frags and len(frags) >= 2:
   599	            frag_smiles = []
   600	            for f in frags:
   601	                if f is None:
   602	                    continue
   603	                s = Chem.MolToSmiles(f)
   604	                if _validate_smiles(s):
   605	                    frag_smiles.append(s)
   606	            if len(frag_smiles) >= 2:
   607	                reactants = ".".join(sorted(frag_smiles)[:2])
   608	                route = _try_route(smiles, reactants)
   609	                if route:
   610	                    # 对 BRICS 碎片也尝试递归
   611	                    sub_routes = []
   612	                    all_trivial = True
   613	                    for r in frag_smiles[:2]:
   614	                        sub = plan_synthesis_recursive(r, max_depth, current_depth + 1, visited.copy())
   615	                        if sub.get("success"):
   616	                            sub_routes.append(sub)
   617	                            if not sub.get("trivial", False):
   618	                                all_trivial = False
   619	                    full_parts = []
   620	                    for sub in sub_routes:
   621	                        if not sub.get("trivial", False):
   622	                            full_parts.append(sub["route"])
   623	                    full_parts.append(route)
   624	                    full_route = " | ".join(full_parts)
   625	                    total_steps = 1 + sum(s.get("steps", 0) for s in sub_routes)
   626	                    return {
   627	                        "success": True,
   628	                        "route": full_route,
   629	                        "steps": total_steps,
   630	                        "trivial": False,
   631	                    }
   632	    except Exception:
   633	        pass
   634	
   635	    # 最终回退: 平凡路线
   636	    return {"success": True, "route": f"{smiles}>>{smiles}", "steps": 0, "trivial": True}
