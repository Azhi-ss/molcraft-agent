   414	def _generate_offspring(seeds, n_offspring_per_seed):
   415	    """从种子分子生成变异后代。
   416	
   417	    利用对接成功的种子作为起点，通过随机变异产生新分子。
   418	    这模拟了进化算法中的"选择+变异"步骤。
   419	    """
   420	    import random
   421	    from evaluator import evaluate_molecule, passes_filters
   422	
   423	    offspring = []
   424	    attempts = 0
   425	    max_attempts = len(seeds) * n_offspring_per_seed * 20
   426	
   427	    while len(offspring) < len(seeds) * n_offspring_per_seed and attempts < max_attempts:
   428	        attempts += 1
   429	        seed = random.choice(seeds)
   430	        seed_smiles = seed.get("smiles", "")
   431	        if not seed_smiles:
   432	            continue
   433	
   434	        # 变异强度：1-4个突变点
   435	        n_mut = random.randint(1, 4)
   436	        new_smiles = random_mutate_smiles(seed_smiles, n_mut)
   437	
   438	        if new_smiles and new_smiles != seed_smiles:
   439	            # 检查是否为单片段（多片段 SMILES 会导致 Meeko 崩溃）
   440	            mol_check = Chem.MolFromSmiles(new_smiles)
   441	            if mol_check is None or len(Chem.GetMolFrags(mol_check)) > 1:
   442	                continue
   443	            props = evaluate_molecule(new_smiles)
   444	            if passes_filters(props):
   445	                offspring.append(props)
   446	    
   447	    return offspring
   448	
   449	
   450	def main():
   451	    parser = argparse.ArgumentParser(description="运行进化迭代版药物研发流程")
   452	    parser.add_argument("--n-generate", type=int, default=50, help="每代生成分子数量 (默认: 50)")
   453	    parser.add_argument("--n-top", type=int, default=10, help="保留 top N 分子 (默认: 10)")
   454	    parser.add_argument("--strategy", choices=["mutate", "combine", "random"], default="mutate",
   455	                        help="生成策略 (默认: mutate)")
   456	    parser.add_argument("--n-generations", type=int, default=2, help="进化代数 (默认: 2)")
   457	    parser.add_argument("--n-offspring", type=int, default=3, help="每个种子的变异体数量 (默认: 3)")
   458	    parser.add_argument("--output-dir", type=str, default="output", help="输出目录")
   459	    parser.add_argument("--no-docking-guidance", action="store_false", dest="use_docking_guidance",
   460	                        help="禁用 H002 对接引导（不推荐，已验证会退化 0.4~0.8 kcal/mol）")
   461	    parser.add_argument("--generator", choices=["mutate", "diffusion", "hybrid"], default="mutate",
   462	                        help="生成器选择: mutate(RDKit变异), diffusion(PocketXMol扩散), hybrid(混合) (默认: mutate)")
   463	    args = parser.parse_args()
   464	
   465	    run_evolutionary_pipeline(
   466	        n_generate=args.n_generate,
   467	        n_top=args.n_top,
   468	        strategy=args.strategy,
   469	        n_generations=args.n_generations,
   470	        n_offspring_per_seed=args.n_offspring,
   471	        output_dir=args.output_dir,
   472	        use_docking_guidance=args.use_docking_guidance,
   473	        generator=args.generator,
   474	    )
   475	
   476	
   477	if __name__ == "__main__":
   478	    main()

