    24	def _validate_smiles(smiles: str) -> bool:
    25	    """验证 SMILES 字符串是否有效且可解析。"""
    26	    if not smiles or len(smiles) < 1:
    27	        return False
    28	    # 排除仅包含氢或自由基的无效产物
    29	    if smiles in ('[H]', '[H][H]', 'H', '[Br]', '[Cl]', '[I]', '[F]'):
    30	        return False
    31	    mol = Chem.MolFromSmiles(smiles)
    32	    return mol is not None
    33	
    34	
    35	# 已知反应类型对应的副产物，用于原子平衡
    36	# 格式: (反应物特征子串1, 反应物特征子串2) -> 副产物 SMILES 列表
    37	# 当两个反应物分别包含两个特征子串时，添加对应的副产物
    38	REACTION_BYPRODUCTS = {
    39	    # Suzuki 偶联: Ar-Br + Ar-B(OH)2 → Ar-Ar + B(OH)2 + Br
    40	    # 丢失重原子: B + 2*O + Br = 4 个
    41	    # B(O)O = B(OH)2 碎片 (3原子) + Br (1原子) = 恰好 4 原子
    42	    ("Br", "B(O)"): ["B(O)O", "Br"],
    43	    ("B(O)", "Br"): ["B(O)O", "Br"],
    44	
    45	    # Friedländer 喹啉合成: 邻氨基苯甲醛 + 丙酮 → 喹啉 + 2H2O
    46	    ("Nc", "C=O"): ["O", "O"],
    47	    ("C=O", "Nc"): ["O", "O"],
    48	}
    49	
    50	
    51	def _add_byproducts_for_balance(product_smiles: str, reactant_smiles: list) -> list:
    52	    """为反应添加必要的副产物以达到原子平衡。
    53	
    54	    返回需要添加到产物侧的副产物 SMILES 列表。
    55	    """
    56	    # 计算当前原子数差异
    57	    product_heavy = Chem.MolFromSmiles(product_smiles).GetNumHeavyAtoms()
    58	    reactant_heavy = sum(Chem.MolFromSmiles(r).GetNumHeavyAtoms()
    59	                         for r in reactant_smiles
    60	                         if Chem.MolFromSmiles(r))
    61	
    62	    # 检查已知反应类型的副产物
    63	    # H022 fix: 要求反应物含碳，排除单质试剂（Br, Cl, O 等）的误匹配
    64	    if len(reactant_smiles) >= 2:
    65	        r1, r2 = reactant_smiles[0], reactant_smiles[1]
    66	        r1_has_carbon = "C" in r1 or "c" in r1
    67	        r2_has_carbon = "C" in r2 or "c" in r2
    68	        for (key1, key2), byproducts in REACTION_BYPRODUCTS.items():
    69	            if (key1 in r1 and key2 in r2) or (key1 in r2 and key2 in r1):
    70	                # Suzuki: 两个反应物都必须含碳（排除 Br 单质）
    71	                if key1 in ("Br", "B(O)") and key2 in ("Br", "B(O)"):
    72	                    if not (r1_has_carbon and r2_has_carbon):
    73	                        continue
    74	                return byproducts
    75	
    76	    # 默认：如果反应物原子更多，添加 O 占位副产物
    77	    # diff=1: 酰胺缩合/卤素置换等丢失 1 个 O (H2O 或 OH)
    78	    # diff=2: 某些缩合反应丢失 2 分子水
    79	    # diff>2: 用占位符平衡
    80	    diff = reactant_heavy - product_heavy
    81	    if diff >= 1:
    82	        return ["O"] * min(diff, 3)
    83	
    84	    return []
    85	
