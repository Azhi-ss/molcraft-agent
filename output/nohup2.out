   927	def _diverse_selection(candidates, n_select, diversity_weight=0.3):
   928	    """多样性保持选择（H011）：使用贪心 MMD 算法选择候选分子。
   929	
   930	    文献依据:
   931	    - MOOSE-Chem (Yang et al., 2025): "Diverse initial population is essential
   932	      for evolutionary search to avoid premature convergence"
   933	    - MolLEO (Wang et al., 2024b): 多目标进化优化中多样性是核心维度
   934	
   935	    算法: Maximum Minimal Distance (MMD) 贪心选择
   936	    1. 计算所有分子的 Morgan 指纹
   937	    2. 从结合能最优分子开始
   938	    3. 迭代选择: 综合评分 = (1-w)×BE_norm + w×diversity_norm
   939	       其中 diversity_norm = min(Tanimoto_distance to already selected)
   940	
   941	    Args:
   942	        candidates: list[dict], 每个含 "smiles", "binding_energy"
   943	        n_select: 选择数量
   944	        diversity_weight: 多样性权重 (0=纯BE, 1=纯多样性)
   945	
   946	    Returns:
   947	        list[dict]: 按综合评分排序的选择结果
   948	    """
   949	    if len(candidates) <= n_select:
   950	        return list(candidates)
   951	
   952	    # 预计算指纹
   953	    fps = []
   954	    for c in candidates:
   955	        try:
   956	            mol = Chem.MolFromSmiles(c["smiles"])
   957	            fp = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=1024)
   958	            fps.append(fp)
   959	        except Exception:
   960	            fps.append(None)
   961	
   962	    # 归一化结合能到 [0, 1]（越低越好 → 归一化后 1 为最好）
   963	    energies = [c.get("binding_energy", 999) for c in candidates]
   964	    e_min, e_max = min(energies), max(energies)
   965	    if e_max > e_min:
   966	        be_norm = [(e_max - e) / (e_max - e_min) for e in energies]
   967	    else:
   968	        be_norm = [0.5] * len(energies)
   969	
   970	    selected = []
   971	    selected_indices = set()
   972	
   973	    # Step 1: 选择结合能最优分子作为起点
   974	    best_idx = min(range(len(candidates)), key=lambda i: energies[i])
   975	    selected.append(candidates[best_idx])
   976	    selected_indices.add(best_idx)
   977	
   978	    # Step 2: 贪心选择剩余分子
   979	    for _ in range(1, n_select):
   980	        best_score = -1
   981	        best_idx = -1
   982	
   983	        for i, cand in enumerate(candidates):
   984	            if i in selected_indices:
   985	                continue
   986	            if fps[i] is None:
   987	                continue
   988	
   989	            # 计算与已选集合的最小 Tanimoto 距离（距离 = 1 - 相似度）
   990	            max_sim = 0.0
   991	            for si in selected_indices:
   992	                if fps[si] is not None:
   993	                    sim = TanimotoSimilarity(fps[i], fps[si])
   994	                    if sim > max_sim:
   995	                        max_sim = sim
   996	            diversity_norm = 1.0 - max_sim  # 距离作为多样性分数
   997	
   998	            # 综合评分
   999	            score = (1 - diversity_weight) * be_norm[i] + diversity_weight * diversity_norm
  1000	            if score > best_score:
