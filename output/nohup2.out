   654	def score_route_quality(route_str: str, smiles: str) -> float:
   655	    """评估逆合成路线的化学合理性（H012）。
   656	
   657	    文献依据:
   658	    - LARC (Baker et al., 2025): Agent-as-a-Judge 逆合成框架，
   659	      路线质量评审是确保合成可行性的关键环节
   660	    - ChemCrow (Bran et al., 2024): 工具输出质量评估决定下游决策可靠性
   661	
   662	    评分维度:
   663	    1. 多步路线 vs 单步（多步更真实，+0.2）
   664	    2. 反应物数量（多组分反应更合理，+0.1-0.2）
   665	    3. 复杂度比（产物/反应物原子比 > 3 为可疑，-0.3）
   666	    4. 单反应物路线（除非是简单的氧化/还原/水解，-0.2）
   667	
   668	    Returns:
   669	        float: 0.0（不可行）到 1.0（非常可行）
   670	    """
   671	    if not route_str or route_str == f"{smiles}>>{smiles}":
   672	        return 0.0  # 平凡路线 = 最低质量
   673	
   674	    steps = route_str.split(" | ")
   675	    step_scores = []
   676	
   677	    for step in steps:
   678	        if " >> " not in step and ">>" not in step:
   679	            continue
   680	
   681	        # 解析反应物和产物
   682	        sep = " >> " if " >> " in step else ">>"
   683	        parts = step.split(sep, 1)
   684	        if len(parts) != 2:
   685	            continue
   686	        reactants_str, product_str = parts
   687	        reactants = [r.strip() for r in reactants_str.split(".") if r.strip()]
   688	
   689	        score = 0.5  # 默认中等
   690	
   691	        # 1. 多反应物路线更真实（大多数合成反应涉及2+组分）
   692	        if len(reactants) >= 2:
   693	            score += 0.2
   694	        elif len(reactants) == 1:
   695	            # 单反应物路线须谨慎 — 检查是否为简单官能团转化
   696	            r_mol = Chem.MolFromSmiles(reactants[0])
   697	            p_mol = Chem.MolFromSmiles(product_str)
   698	            if r_mol and p_mol:
   699	                r_atoms = r_mol.GetNumAtoms()
   700	                p_atoms = p_mol.GetNumAtoms()
   701	                if p_atoms > r_atoms + 5:
   702	                    # 单反应物生成更大产物 — 极不可能
   703	                    score -= 0.3
   704	                elif p_atoms <= r_atoms:
   705	                    # 单反应物生成等大或更小产物 — 可能是脱保护/还原/氧化
   706	                    score += 0.1
   707	
   708	        # 2. 反应物复杂度检查
   709	        r_total_atoms = 0
   710	        for r in reactants:
   711	            r_mol = Chem.MolFromSmiles(r)
   712	            if r_mol:
   713	                r_total_atoms += r_mol.GetNumAtoms()
   714	
   715	        p_mol = Chem.MolFromSmiles(product_str)
   716	        if p_mol and r_total_atoms > 0:
   717	            ratio = p_mol.GetNumAtoms() / r_total_atoms
   718	            if ratio > 3.0:
   719	                # 产物远大于反应物之和 — 不可行的单步转化
   720	                score -= 0.3
   721	            elif ratio > 2.0:
   722	                score -= 0.1
   723	
   724	        # 3. 检查是否为同一分子（无转化）
   725	        if len(reactants) == 1 and reactants[0] == product_str:
   726	            score = 0.0
   727	
   728	        step_scores.append(max(0.0, min(1.0, score)))
   729	
   730	    if not step_scores:
   731	        return 0.0
   732	
   733	    # 平均分 + 多步路线奖励
   734	    avg = sum(step_scores) / len(step_scores)
   735	    if len(step_scores) >= 2:
   736	        # 多步路线通常更接近真实合成策略
   737	        avg = min(1.0, avg + 0.15)
   738	
   739	    return round(avg, 3)
