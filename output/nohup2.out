   191	def _is_simple_molecule(smiles: str) -> bool:
   192	    """判断分子是否为足够简单的起始原料，无需继续逆合成。
   193	    
   194	    H015 修复: 不再将多环芳烃/联芳基误判为"简单"。
   195	    含苯环且 ≤15 原子的分子如果是单环则简单，多环则可能需要断键。
   196	    文献依据: LARC (2025) — 起始原料应为商业可得的单环简单分子。
   197	    """
   198	    mol = Chem.MolFromSmiles(smiles)
   199	    if mol is None:
   200	        return False
   201	    # 原子数 <= 10 视为简单
   202	    if mol.GetNumAtoms() <= 10:
   203	        return True
   204	    # 匹配常见简单骨架
   205	    for s in _SIMPLE_SCAFFOLDS_SMARTS:
   206	        patt = Chem.MolFromSmarts(s)
   207	        if patt and mol.HasSubstructMatch(patt):
   208	            # H015 修复: 只接受单环或几乎无取代的分子（≤12 原子）
   209	            # 排除多环芳烃（联苯、萘等）被误判为"简单"
   210	            n_atoms = mol.GetNumAtoms()
   211	            ring_info = mol.GetRingInfo()
   212	            n_rings = ring_info.NumRings()
   213	            # 单环 + ≤15 原子 → 简单
   214	            if n_rings == 1 and n_atoms <= 15:
   215	                return True
   216	            # 多环但很小（如萘本身只有 10 原子）→ 简单
   217	            if n_rings >= 2 and n_atoms <= 10:
   218	                return True
   219	    return False
