   180	# 简单分子阈值：原子数 <= 10 或属于常见起始原料，停止递归
   181	_SIMPLE_SCAFFOLDS_SMARTS = [
   182	    "c1ccccc1",      # 苯
   183	    "c1ccncc1",      # 吡啶
   184	    "c1cccnc1",      # 吡啶变体
   185	    "C1CCOC1",       # THF
   186	    "C1CCCCC1",      # 环己烷
   187	    "C1CCNC1",       # 吡咯烷
   188	]
