    47	def run_evolutionary_pipeline(
    48	    n_generate=50,
    49	    n_top=10,
    50	    strategy="mutate",
    51	    n_generations=2,
    52	    n_offspring_per_seed=3,
    53	    output_dir="output",
    54	    use_docking_guidance=True,
    55	    generator="mutate",
    56	    logger=None,  # Optional EventLogger instance
    57	):
    58	    """运行进化式迭代药物研发流程。
    59	
    60	    Args:
    61	        n_generate: 每代生成的分子数量
    62	        n_top: 最终保留的top N分子
    63	        strategy: 生成策略
    64	        n_generations: 进化代数（包括初始代）
    65	        n_offspring_per_seed: 每个种子产生的变异体数量
    66	        output_dir: 输出目录
    67	        use_docking_guidance: 是否使用 H002 对接引导生成
    68	        generator: 生成器选择 - "mutate"(RDKit), "diffusion"(PocketXMol), "hybrid"(混合)
    69	        logger: 可选的 EventLogger 实例，用于结构化日志输出
    70	    """
    71	    os.makedirs(output_dir, exist_ok=True)
    72	    log_lines = []
    73	
    74	    log("=" * 60, log_lines)
    75	    log("MolCraft Agent 进化迭代版开始执行", log_lines)
    76	    log(f"配置: n_generate={n_generate}, n_generations={n_generations}, "
    77	        f"n_offspring={n_offspring_per_seed}, strategy={strategy}, "
    78	        f"docking_guidance={use_docking_guidance}, generator={generator}", log_lines)
    79	    log("=" * 60, log_lines)
    80	
    81	    # 步骤 1: 准备受体
    82	    log("步骤 1: 准备受体", log_lines)
    83	    prepare_receptor()
    84	    log("受体准备完成", log_lines)
    85	
    86	    # 进化迭代
    87	    all_docked = []  # 累积所有对接成功的分子
    88	    current_seeds = None  # 当前代的种子
    89	
    90	    for gen in range(n_generations):
    91	        log("-" * 60, log_lines)
    92	        log(f"进化第 {gen + 1}/{n_generations} 代", log_lines)
    93	        log("-" * 60, log_lines)
    94	
    95	        if gen == 0:
    96	            # 初始代
    97	            if generator in ("diffusion", "hybrid"):
    98	                diffusion_mols = _generate_diffusion(n_generate, log_lines)
    99	                if diffusion_mols:
   100	                    log(f"扩散模型生成了 {len(diffusion_mols)} 个分子", log_lines)
   101	                else:
   102	                    log("扩散模型生成失败或不可用", log_lines)
   103	
   104	                if generator == "diffusion":
   105	                    mols = diffusion_mols if diffusion_mols else generate_molecules(
   106	                        strategy=strategy, n_molecules=n_generate,
   107	                    )
   108	                else:  # hybrid
   109	                    n_diffusion = len(diffusion_mols) if diffusion_mols else 0
   110	                    n_rdkit = max(n_generate - n_diffusion, n_generate // 2)
   111	                    rdkit_mols = generate_molecules(strategy=strategy, n_molecules=n_rdkit)
   112	                    mols = (diffusion_mols or []) + rdkit_mols
   113	                    log(f"混合模式: 扩散 {n_diffusion} + RDKit {len(rdkit_mols)}", log_lines)
   114	            elif use_docking_guidance:
   115	                # H002: 使用对接引导生成
   116	                log(f"初始代: 使用对接引导生成 (batch_size=10, n_generations=3)", log_lines)
   117	                mols = generate_with_docking_guidance(
   118	                    docking_fn=dock_molecule,
   119	                    n_molecules=n_generate,
   120	                    batch_size=10,
   121	                    n_generations=3,
   122	                    top_k=5,
   123	                    strategy=strategy,
   124	                )
   125	                log(f"对接引导生成完成，获得 {len(mols)} 个分子", log_lines)
   126	            else:
   127	                log(f"初始代: 生成候选分子 (strategy={strategy}, n={n_generate})", log_lines)
   128	                mols = generate_molecules(strategy=strategy, n_molecules=n_generate)
   129	        else:
   130	            # 后续代：从上一代top种子变异生成
   131	            log(f"第 {gen + 1} 代: 从 top {len(current_seeds)} 种子变异生成", log_lines)
   132	            mols = _generate_offspring(current_seeds, n_offspring_per_seed)
   133	
   134	        log(f"本代生成 {len(mols)} 个通过过滤的分子", log_lines)
   135	
   136	        # 对接（如果用了 docking_guidance，mols 已经包含对接结果）
   137	        if use_docking_guidance and gen == 0:
   138	            # 初始代已对接，直接使用
   139	            successful = [d for d in mols if d.get("docking_success")]
   140	            successful.sort(key=lambda x: x.get("binding_energy", 999))
   141	            log(f"对接引导生成已包含对接结果，成功 {len(successful)}/{len(mols)}", log_lines)
   142	        else:
   143	            log(f"第 {gen + 1} 代: 分子对接", log_lines)
   144	            docked = batch_dock(mols)
   145	            successful = [d for d in docked if d.get("success")]
   146	            successful.sort(key=lambda x: x.get("binding_energy", 999))
   147	            log(f"对接成功 {len(successful)}/{len(mols)} 个分子", log_lines)
   148	
   149	        # 累积到全局池
   150	        all_docked.extend(successful)
   151	        all_docked.sort(key=lambda x: x.get("binding_energy", 999))
   152	
   153	        # 选择下一代种子（取本代top，避免过度收敛）
   154	        n_seeds = min(20, len(successful))
   155	        current_seeds = successful[:n_seeds]
   156	        log(f"选择 {n_seeds} 个种子进入下一代", log_lines)
   157	        if successful:
   158	            log(f"本代最佳结合能: {successful[0].get('binding_energy')} kcal/mol", log_lines)
   159	            log(f"全局最佳结合能: {all_docked[0].get('binding_energy')} kcal/mol", log_lines)
   160	
   161	    # 最终选择
   162	    log("-" * 60, log_lines)
   163	    log("最终选择: 从所有代中选择 top 分子", log_lines)
   164	
   165	    # 去重（按SMILES）
   166	    seen = set()
   167	    unique_docked = []
   168	    for d in all_docked:
   169	        smi = d.get("smiles", "")
   170	        if smi and smi not in seen:
   171	            seen.add(smi)
   172	            unique_docked.append(d)
   173	
   174	    unique_docked.sort(key=lambda x: x.get("binding_energy", 999))
   175	
   176	    # H009: 共识对接 — 对 top 候选分子用多次独立对接取中位数
   177	    # Coscientist 模式："performing experiments multiple times"
   178	    # 消除单次对接的随机噪声，提升最终排名可靠性
   179	    N_CONSENSUS = min(n_top * 2, len(unique_docked))
   180	    log(f"共识对接: 对 top {N_CONSENSUS} 候选执行 3 次独立对接取中位数...", log_lines)
   181	    consensus_top = unique_docked[:N_CONSENSUS]
   182	    consensus_results = []
   183	    for i, candidate in enumerate(consensus_top):
   184	        smiles = candidate.get("smiles", "")
   185	        if not smiles:
   186	            continue
   187	        cresult = dock_molecule_consensus(smiles)
   188	        if cresult.get("success"):
   189	            candidate["binding_energy"] = cresult["binding_energy"]
   190	            candidate["consensus_std"] = cresult.get("std_energy", 0.0)
   191	            candidate["consensus_n"] = cresult.get("n_success", 0)
   192	            consensus_results.append(candidate)
   193	            log(f"  [{i+1}/{N_CONSENSUS}] {smiles[:40]}... "
   194	                f"median={cresult['binding_energy']:.3f} std={cresult['std_energy']:.3f} "
   195	                f"(n={cresult['n_success']})", log_lines)
   196	
   197	    # 按中位数结合能重新排序
   198	    consensus_results.sort(key=lambda x: x.get("binding_energy", 999))
   199	
   200	    # 合并回 unique_docked：共识候选用新分数，其余保持不变
   201	    consensus_smiles = {r["smiles"] for r in consensus_results}
   202	    remaining = [d for d in unique_docked if d.get("smiles") not in consensus_smiles]
   203	    unique_docked = consensus_results + remaining
   204	
   205	    # H012: 路线质量评分（LARC Agent-as-a-Judge 模式）
   206	    # 对候选池做逆合成规划 → 评分 → 复合排序
   207	    from synthesis_v2 import score_route_quality
   208	
   209	    candidate_pool_size = min(n_top * 3, len(unique_docked))
   210	    candidate_pool = unique_docked[:candidate_pool_size]
   211	    log(f"去重后共 {len(unique_docked)} 个独特分子，候选池 {candidate_pool_size} 个进行路线评分", log_lines)
   212	
   213	    if not candidate_pool:
   214	        log("错误: 没有分子对接成功", log_lines)
   215	        sys.exit(1)
   216	
   217	    # 逆合成规划 + 路线质量评分
   218	    log(f"为候选池 {len(candidate_pool)} 个分子规划合成路线并评分", log_lines)
   219	    scored_candidates = []
   220	    for mol in candidate_pool:
   221	        smiles = mol["smiles"]
   222	        syn = plan_synthesis_v2(smiles)
   223	        route = syn.get("route", f"{smiles}>>{smiles}") if syn.get("success") else f"{smiles}>>{smiles}"
   224	        is_trivial = syn.get("trivial", False) or route == f"{smiles}>>{smiles}"
   225	        quality = score_route_quality(route, smiles)
   226	        scored_candidates.append({
   227	            "mol_smiles": smiles,
   228	            "route": route,
   229	            "binding_energy": mol.get("binding_energy"),
   230	            "qed": mol.get("qed"),
   231	            "trivial": is_trivial,
   232	            "route_quality": quality,
   233	            "syn_steps": syn.get("steps", 0),
   234	        })
   235	
   236	        if logger is not None:
   237	            composite = 0.0  # will be recalculated in H012 scoring below
   238	            logger.log_molecule(MoleculeEvent(
   239	                mol_smiles=smiles,
   240	                binding_energy=mol.get("binding_energy") or 0.0,
   241	                composite_score=composite,
   242	                syn_steps=syn.get("steps", 0),
   243	                sa_score=syn.get("sa_score"),
   244	                qed=mol.get("qed") or 0.0,
   245	                rings=count_rings(smiles),
   246	                trivial=is_trivial,
   247	                route_quality=quality,
   248	                docking_std=mol.get("consensus_std"),
   249	            ))
   250	
   251	    # H012 复合评分: 0.8×BE_norm + 0.2×route_quality
   252	    energies_all = [c["binding_energy"] for c in scored_candidates if c["binding_energy"] is not None]
   253	    if energies_all:
   254	        e_min, e_max = min(energies_all), max(energies_all)
   255	        if e_max > e_min:
   256	            for c in scored_candidates:
   257	                if c["binding_energy"] is not None:
   258	                    be_norm = (e_max - c["binding_energy"]) / (e_max - e_min)
   259	                else:
   260	                    be_norm = 0.0
   261	                c["composite_score"] = 0.8 * be_norm + 0.2 * c["route_quality"]
   262	        else:
   263	            for c in scored_candidates:
   264	                c["composite_score"] = c["route_quality"]
   265	
   266	        # 按复合评分排序（越高越好）
   267	        scored_candidates.sort(key=lambda x: x.get("composite_score", 0), reverse=True)
   268	        log(f"复合评分排序完成 (0.8×BE + 0.2×路线质量)", log_lines)
   269	
   270	    # 选择 top N
   271	    final_top = scored_candidates[:n_top]
   272	    results = []
   273	    trivial_count = 0
   274	    for c in final_top:
   275	        if c["trivial"]:
   276	            trivial_count += 1
   277	        results.append({
   278	            "mol_smiles": c["mol_smiles"],
   279	            "route": c["route"],
   280	            "binding_energy": c["binding_energy"],
   281	            "qed": c["qed"],
   282	            "trivial": c["trivial"],
   283	        })
   284	        log(f"  {c['mol_smiles'][:50]}... BE={c['binding_energy']} "
   285	            f"steps={c['syn_steps']} quality={c['route_quality']:.2f} "
   286	            f"composite={c['composite_score']:.3f}"
   287	            f"{' [TRIVIAL]' if c['trivial'] else ''}", log_lines)
   288	
   289	    # 统计
   290	    energies = [r["binding_energy"] for r in results if r["binding_energy"] is not None]
   291	    if energies:
   292	        avg_energy = sum(energies) / len(energies)
   293	        log(f"Top {len(results)} 平均结合能: {avg_energy:.3f} kcal/mol", log_lines)
   294	        log(f"最佳结合能: {min(energies):.3f} kcal/mol", log_lines)
   295	        log(f"Trivial route 比例: {trivial_count}/{len(results)} ({trivial_count/len(results)*100:.1f}%)", log_lines)
   296	
   297	    # 保存 CSV：先写临时文件，验证后原子替换，避免部分写入文件
   298	    csv_path = os.environ.get("MOLCRAFT_CSV_PATH", os.path.join(output_dir, "result.csv"))
   299	    csv_dir = os.path.dirname(os.path.abspath(csv_path)) or output_dir
   300	    fd, temp_csv = tempfile.mkstemp(prefix="result.", suffix=".csv.tmp", dir=csv_dir)
   301	    os.close(fd)
   302	
   303	    try:
   304	        with open(temp_csv, "w", newline="", encoding="utf-8") as f:
   305	            writer = csv.DictWriter(f, fieldnames=["mol_smiles", "route"])
   306	            writer.writeheader()
   307	            for row in results:
   308	                writer.writerow({"mol_smiles": row["mol_smiles"], "route": row["route"]})
   309	
   310	        # 原子替换：只有完整写入成功后才替换正式文件
   311	        os.replace(temp_csv, csv_path)
   312	        log(f"结果已保存到 {csv_path}", log_lines)
   313	    except Exception as e:
   314	        if os.path.exists(temp_csv):
   315	            os.unlink(temp_csv)
   316	        log(f"CSV 写入失败: {e}", log_lines)
   317	        raise
   318	
   319	    # 结构化日志：通过 EventLogger 输出 metrics
   320	    if logger is not None:
   321	        energies = [r["binding_energy"] for r in results if r["binding_energy"] is not None]
   322	        steps = [r.get("syn_steps", 0) for r in results]
   323	        logger.log_metrics(MetricsEvent(
   324	            molecule_count=len(results),
   325	            non_trivial_count=len(results) - trivial_count,
   326	            trivial_count=trivial_count,
   327	            avg_binding_energy=sum(energies) / len(energies) if energies else None,
   328	            min_binding_energy=min(energies) if energies else None,
   329	            avg_syn_steps=sum(steps) / len(steps) if steps else None,
   330	            docking_success_rate=0.0,
   331	        ))
   332	
   333	    # 打印摘要
   334	    log("=" * 60, log_lines)
   335	    log("流程完成", log_lines)
   336	    log(f"最佳结合能: {results[0]['binding_energy']} kcal/mol", log_lines)
   337	    log(f"输出文件: {csv_path}", log_lines)
   338	    log("=" * 60, log_lines)
   339	
   340	    return results
