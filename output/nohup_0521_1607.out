    30	def load_calibration(path=None) -> dict:
    31	    """Load calibration from JSON file.
    32	
    33	    Args:
    34	        path: Path to calibration JSON. Defaults to data/calibration.json.
    35	
    36	    Returns:
    37	        Calibration dict with binding_score and sa_score keys.
    38	    """
    39	    if path is None:
    40	        path = CALIBRATION_PATH
    41	
    42	    if Path(path).exists():
    43	        with open(path) as f:
    44	            cal = json.load(f)
    45	        # Merge with defaults for any missing keys
    46	        result = DEFAULT_CALIBRATION.copy()
    47	        result.update(cal)
    48	        for key in DEFAULT_CALIBRATION:
    49	            if key not in cal and isinstance(DEFAULT_CALIBRATION[key], dict):
    50	                result[key] = DEFAULT_CALIBRATION[key]
    51	            elif key in cal and isinstance(DEFAULT_CALIBRATION.get(key), dict) and isinstance(cal[key], dict):
    52	                merged = DEFAULT_CALIBRATION[key].copy()
    53	                merged.update(cal[key])
    54	                result[key] = merged
    55	        return result
    56	    return DEFAULT_CALIBRATION.copy()
    57	
    58	
    59	def save_calibration(cal: dict, path=None):
    60	    """Save calibration to JSON file.
    61	
    62	    Args:
    63	        cal: Calibration dict to save.
    64	        path: Path to write. Defaults to data/calibration.json.
    65	    """
    66	    if path is None:
    67	        path = CALIBRATION_PATH
    68	
    69	    Path(path).parent.mkdir(parents=True, exist_ok=True)
    70	    with open(path, "w") as f:
    71	        json.dump(cal, f, indent=2)
    72	
    73	
    74	def compute_validity_score(smiles: str) -> float:
    75	    """Compute validity score for a SMILES string.
    76	
    77	    Args:
    78	        smiles: SMILES string to validate.
    79	
    80	    Returns:
    81	        1.0 if valid SMILES, 0.0 otherwise.
    82	    """
    83	    if not smiles:
    84	        return 0.0
    85	    mol = Chem.MolFromSmiles(smiles)
    86	    return 1.0 if mol is not None else 0.0
    87	
    88	
    89	def compute_sa_score_normalized(sa_raw: float, cal: dict = None) -> float:
    90	    """Normalize SA score to 0-1 (lower SA = higher score).
    91	
    92	    Supports:
    93	    - step: SA >= cutoff → 0, else (cutoff - sa) / scale
    94	    - inverted: (max_sa - sa) / scale
    95	    """
    96	    if cal is None:
    97	        cal = load_calibration()
    98	
    99	    sa_cal = cal.get("sa_score", DEFAULT_CALIBRATION["sa_score"])
   100	    func = sa_cal.get("function", "step")
   101	    params = sa_cal.get("params", sa_cal)
   102	
   103	    if func == "step":
   104	        cutoff = params.get("cutoff", 4.0)
   105	        scale = params.get("scale", 4.0)
   106	        if sa_raw >= cutoff:
   107	            return 0.0
   108	        score = (cutoff - sa_raw) / scale
   109	    elif func == "inverted":
   110	        max_sa = params.get("max_sa", 10.0)
   111	        scale = params.get("scale", 10.0)
   112	        score = (max_sa - sa_raw) / scale
   113	    else:
   114	        raise ValueError(f"Unknown sa_score function: {func}")
   115	
   116	    return max(0.0, min(1.0, score))
   117	
   118	
   119	def compute_binding_score(vina_raw: float, cal: dict = None) -> float:
   120	    """Normalize binding score (Vina) using clipped linear or minmax.
   121	
   122	    Args:
   123	        vina_raw: Raw Vina binding score (typically negative).
   124	        cal: Optional calibration dict. Defaults to loaded calibration.
   125	
   126	    Returns:
   127	        Normalized score in [0, 1].
   128	    """
   129	    if cal is None:
   130	        cal = load_calibration()
   131	
   132	    binding_cal = cal.get("binding_score", DEFAULT_CALIBRATION["binding_score"])
   133	    func = binding_cal.get("function", binding_cal.get("type", "clipped_linear"))
   134	    params = binding_cal.get("params", binding_cal)  # support both nested and flat
   135	
   136	    if func == "clipped_linear":
   137	        threshold = params.get("threshold", 0.0)
   138	        range_ = params.get("range", 15.0)
   139	        score = (threshold - vina_raw) / range_
   140	    elif func == "minmax":
   141	        min_val = params.get("min", -15.0)
   142	        max_val = params.get("max", 0.0)
   143	        score = (vina_raw - min_val) / (max_val - min_val)
   144	    else:
   145	        raise ValueError(f"Unknown binding normalization function: {func}")
   146	
   147	    return max(0.0, min(1.0, score))
   148	
   149	
   150	def compute_route_validity_score(routes_valid: list[bool]) -> float:
   151	    """Fraction of routes that pass validity checks. Empty list → 0.0."""
   152	    if not routes_valid:
   153	        return 0.0
   154	    return sum(routes_valid) / len(routes_valid)
   155	
   156	
   157	def compute_balance_score(reactant_heavy: int, product_heavy: int) -> float:
   158	    """0-1 score based on atom balance. Perfect=1.0, >50% imbalance=0.0.
   159	    ratio = product_heavy / reactant_heavy
   160	    If ratio < 0.5 or ratio > 1.5 → 0.0
   161	    Else: max(0.0, 1.0 - 2.0 * abs(1.0 - ratio))
   162	    """
   163	    if reactant_heavy == 0:
   164	        return 1.0 if product_heavy == 0 else 0.0
   165	    ratio = product_heavy / reactant_heavy
   166	    if ratio < 0.5 or ratio > 1.5:
   167	        return 0.0
   168	    return max(0.0, 1.0 - 2.0 * abs(1.0 - ratio))
   169	
   170	
   171	def compute_step_penalty_score(n_steps: int) -> float:
   172	    """1.0 for 1 step, decreasing by 0.15 per extra step. n_steps<=0 → 0.0."""
   173	    if n_steps <= 0:
   174	        return 0.0
   175	    return max(0.0, 1.0 - 0.15 * (n_steps - 1))
   176	
   177	
   178	def compute_starting_material_availability_score(reactant_smiles: list[str]) -> float:
   179	    """Heuristic: SA < 4 → 1.0, SA 4-6 → 0.5, SA > 6 → 0.0. Average over all reactants.
   180	    Empty list → 0.0. Uses estimate_sa_score from evaluator.
   181	    """
   182	    if not reactant_smiles:
   183	        return 0.0
   184	    scores = []
   185	    for smi in reactant_smiles:
   186	        mol = Chem.MolFromSmiles(smi)
   187	        if mol is None:
   188	            continue
   189	        sa = estimate_sa_score(mol)
   190	        if sa < 4:
   191	            scores.append(1.0)
   192	        elif sa <= 6:
   193	            scores.append(0.5)
   194	        else:
   195	            scores.append(0.0)
   196	    if not scores:
   197	        return 0.0
   198	    return sum(scores) / len(scores)
   199	
   200	
   201	def compute_mol_score(binding_score: float, validity_score: float, sa_score: float) -> float:
   202	    """Molecular score = 0.8*binding + 0.1*validity + 0.1*sa."""
   203	    return 0.8 * binding_score + 0.1 * validity_score + 0.1 * sa_score
   204	
   205	
   206	def compute_route_score(
   207	    route_validity: float,
   208	    sm_availability: float,
   209	    step_penalty: float,
   210	    convergence: float,
   211	    balance: float,
   212	) -> float:
   213	    """Route score = 0.55*route_validity + 0.30*sm_availability + 0.05*step_penalty + 0.05*convergence + 0.05*balance."""
   214	    return (
   215	        0.55 * route_validity
   216	        + 0.30 * sm_availability
   217	        + 0.05 * step_penalty
   218	        + 0.05 * convergence
   219	        + 0.05 * balance
   220	    )
   221	
   222	
   223	def compute_total_score(mol_score: float, route_score: float) -> float:
   224	    """Total = 0.7*mol + 0.3*route."""
   225	    return 0.7 * mol_score + 0.3 * route_score
   226	
   227	
   228	def _is_trivial_route(route: str, target_smiles: str) -> bool:
   229	    """Check if route is trivial (A>>A).
   230	
   231	    - No >> in route → True
   232	    - Single reactant identical to product → True
   233	    - Single reactant identical to first product (before any .) → True
   234	    - Otherwise → False
   235	    """
   236	    if ">>" not in route:
   237	        return True
   238	
   239	    parts = route.split(">>")
   240	    if len(parts) != 2:
   241	        return False
   242	
   243	    reactants_str, products_str = parts
   244	
   245	    # Check single reactant identical to product
   246	    reactants = [r.strip() for r in reactants_str.split(".")]
   247	    if len(reactants) == 1:
   248	        reactant = reactants[0]
   249	        product = products_str.strip()
   250	        # Remove any . separated additional products for comparison
   251	        first_product = product.split(".")[0].strip()
   252	        if reactant == product or reactant == first_product:
   253	            return True
   254	
   255	    return False
   256	
   257	
   258	def score_csv(csv_path: str, vina_scores: dict = None, cal: dict = None) -> dict:
   259	    """Score a result.csv file and return full scoring report.
   260	
   261	    Args:
   262	        csv_path: Path to result.csv (columns: mol_smiles,route)
   263	        vina_scores: Dict mapping SMILES → Vina raw score (kcal/mol, negative)
   264	        cal: Calibration params (loaded from file if None)
   265	
   266	    Returns:
   267	        Dict with keys: total_score, mol_score, route_score, binding_score,
   268	        validity_score, sa_score, route_validity_score,
   269	        starting_material_availability_score, sample_count
   270	        All float values rounded to 6 decimal places.
   271	    """
   272	    import math
   273	
   274	    if vina_scores is None:
   275	        vina_scores = {}
   276	    if cal is None:
   277	        cal = load_calibration()
   278	
   279	    rows = []
   280	    with open(csv_path, newline="") as f:
   281	        reader = csv.DictReader(f)
   282	        for row in reader:
   283	            rows.append(row)
   284	
   285	    # Validate required columns (H1 fix: fail fast with clear error)
   286	    if rows:
   287	        header = set(rows[0].keys())
   288	        if "mol_smiles" not in header:
   289	            raise ValueError("CSV is missing required column: 'mol_smiles'")
   290	        if "route" not in header:
   291	            raise ValueError("CSV is missing required column: 'route'")
   292	
   293	    if not rows:
   294	        return {
   295	            "total_score": 0.0,
   296	            "mol_score": 0.0,
   297	            "route_score": 0.0,
   298	            "binding_score": 0.0,
   299	            "validity_score": 0.0,
   300	            "sa_score": 0.0,
   301	            "route_validity_score": 0.0,
   302	            "starting_material_availability_score": 0.0,
   303	            "sample_count": 0,
   304	        }
   305	
   306	    validity_scores = []
   307	    binding_scores = []
   308	    sa_scores = []
   309	    route_validity_flags = []
   310	    sm_availabilities = []
   311	    step_penalties = []
   312	
   313	    for row in rows:
   314	        mol_smiles = row.get("mol_smiles", "").strip()
   315	        route = row.get("route", "").strip()
   316	
   317	        # Validity
   318	        val_score = compute_validity_score(mol_smiles)
   319	        validity_scores.append(val_score)
   320	
   321	        # Binding
   322	        vina_raw = vina_scores.get(mol_smiles, None)
   323	        if vina_raw is not None:
   324	            b_score = compute_binding_score(vina_raw, cal)
   325	        else:
   326	            b_score = 0.0
   327	        binding_scores.append(b_score)
   328	
   329	        # SA score
   330	        mol = Chem.MolFromSmiles(mol_smiles) if mol_smiles else None
   331	        if mol is not None:
   332	            sa_raw = estimate_sa_score(mol)
   333	            s_score = compute_sa_score_normalized(sa_raw, cal)
   334	        else:
   335	            s_score = 0.0
   336	        sa_scores.append(s_score)
   337	
   338	        # Route validity (trivial check)
   339	        is_non_trivial = not _is_trivial_route(route, mol_smiles)
   340	        route_validity_flags.append(is_non_trivial)
   341	
   342	        # Extract reactants from LAST step for SM availability
   343	        # Route format: step1 | step2 | step3  or  reactant1.reactant2>>product
   344	        # Multi-step: "A>>B | C>>D | D>>E" → last step is "D>>E"
   345	        # Single step: "A.B>>C"
   346	        reactants_for_sm = []
   347	        if ">>" in route:
   348	            # Split by >> to get the last reaction step
   349	            steps = route.split("|")
   350	            last_step = steps[-1].strip()
   351	            if ">>" in last_step:
   352	                reactants_side = last_step.split(">>")[0].strip()
   353	                reactants_for_sm = [r.strip() for r in reactants_side.split(".") if r.strip()]
   354	
   355	        sm_avail = compute_starting_material_availability_score(reactants_for_sm)
   356	        sm_availabilities.append(sm_avail)
   357	
   358	        # Step count: number of | separators + 1 (0 for empty routes)
   359	        n_steps = route.count("|") + 1 if route.strip() else 0
   360	        step_penalty = compute_step_penalty_score(n_steps)
   361	        step_penalties.append(step_penalty)
   362	
   363	    # Average across molecules
   364	    n = len(rows)
   365	    avg_validity = sum(validity_scores) / n if n > 0 else 0.0
   366	    avg_binding = sum(binding_scores) / n if n > 0 else 0.0
   367	    avg_sa = sum(sa_scores) / n if n > 0 else 0.0
   368	    avg_sm_avail = sum(sm_availabilities) / n if n > 0 else 0.0
   369	    avg_step_penalty = sum(step_penalties) / n if n > 0 else 0.0
   370	
   371	    # Route validity: fraction of non-trivial valid routes
   372	    # Use route_validity_flags directly (True = non-trivial = valid route)
   373	    route_validity = sum(route_validity_flags) / n if n > 0 else 0.0
   374	
   375	    # Compute balance scores from actual route atom counts
   376	    balance_scores = []
   377	    for row in rows:
   378	        mol_smiles = row.get("mol_smiles", "").strip()
   379	        route = row.get("route", "").strip()
   380	        if ">>" not in route or _is_trivial_route(route, mol_smiles):
   381	            balance_scores.append(0.0)
   382	            continue
   383	        step_scores = []
   384	        for step in route.split("|"):
   385	            step = step.strip()
   386	            if ">>" not in step:
   387	                continue
   388	            left, right = step.split(">>", 1)
   389	            reactants = [r.strip() for r in left.split(".") if r.strip()]
   390	            products = [p.strip() for p in right.split(".") if p.strip()]
   391	            r_heavy = 0
   392	            p_heavy = 0
   393	            for r in reactants:
   394	                m = Chem.MolFromSmiles(r)
   395	                if m:
   396	                    r_heavy += m.GetNumHeavyAtoms()
   397	            for p in products:
   398	                m = Chem.MolFromSmiles(p)
   399	                if m:
   400	                    p_heavy += m.GetNumHeavyAtoms()
   401	            step_scores.append(compute_balance_score(r_heavy, p_heavy))
   402	        if step_scores:
   403	            balance_scores.append(sum(step_scores) / len(step_scores))
   404	        else:
   405	            balance_scores.append(0.0)
   406	    avg_balance = sum(balance_scores) / len(balance_scores) if balance_scores else 0.0
   407	
   408	    # Route validity: non-trivial AND all steps have non-zero balance
   409	    for i, row in enumerate(rows):
   410	        if balance_scores[i] == 0.0 and route_validity_flags[i]:
   411	            route_validity_flags[i] = False
   412	    route_validity = sum(route_validity_flags) / n if n > 0 else 0.0
   413	
   414	    # Use placeholder for convergence (route convergence not easy to compute)
   415	    convergence = 1.0
   416	
   417	    # Compute sub-scores
   418	    mol_score = compute_mol_score(avg_binding, avg_validity, avg_sa)
   419	    route_score = compute_route_score(
   420	        route_validity, avg_sm_avail, avg_step_penalty, convergence, avg_balance
   421	    )
   422	    total_score = compute_total_score(mol_score, route_score)
   423	
   424	    def r6(x):
   425	        """Round to 6 decimal places."""
   426	        return math.floor(x * 1_000_000 + 0.5) / 1_000_000
   427	
   428	    return {
   429	        "total_score": r6(total_score),
   430	        "mol_score": r6(mol_score),
   431	        "route_score": r6(route_score),
   432	        "binding_score": r6(avg_binding),
   433	        "validity_score": r6(avg_validity),
   434	        "sa_score": r6(avg_sa),
   435	        "route_validity_score": r6(route_validity),
   436	        "starting_material_availability_score": r6(avg_sm_avail),
   437	        "sample_count": n,
   438	    }
