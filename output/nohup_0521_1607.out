    40	    pkill -f "ssh.*$TUNNEL_PORT.*localhost:$GPU_PORT.*$GPU_SERVER" 2>/dev/null || true
    41	    ssh -fNL "$TUNNEL_PORT:localhost:$GPU_PORT" "$GPU_SERVER"
