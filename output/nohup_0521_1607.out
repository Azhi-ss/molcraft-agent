   260	                binding_energy=mol.get("binding_energy") or 0.0,
   261	                composite_score=composite,
   262	                syn_steps=syn.get("steps", 0),
   263	                sa_score=syn.get("sa_score"),
   264	                qed=mol.get("qed") or 0.0,
   265	                rings=count_rings(smiles),
   266	                trivial=is_trivial,
   267	                route_quality=quality,
   268	                docking_std=mol.get("consensus_std"),
   269	            ))
   270	
   271	    # H012+H030 复合评分: 0.75×BE_norm + 0.15×route_quality + 0.10×logp_score
   272	    # H030: LogP penalty counters Vina hydrophobic bias that over-rewards
   273	    # large polycyclic aromatics (LogP>4) which retrosynthesis rules cannot handle.
   274	    energies_all = [c["binding_energy"] for c in scored_candidates if c["binding_energy"] is not None]
   275	    if energies_all:
   276	        e_min, e_max = min(energies_all), max(energies_all)
   277	        if e_max > e_min:
   278	            for c in scored_candidates:
   279	                if c["binding_energy"] is not None:
   280	                    be_norm = (e_max - c["binding_energy"]) / (e_max - e_min)
   281	                else:
   282	                    be_norm = 0.0
   283	                # H030: LogP score penalizes excessively lipophilic molecules
   284	                logp_score = compute_logp_score(c.get("logp", 0.0))
   285	                c["composite_score"] = 0.75 * be_norm + 0.15 * c["route_quality"] + 0.10 * logp_score
   286	        else:
   287	            for c in scored_candidates:
   288	                logp_score = compute_logp_score(c.get("logp", 0.0))
   289	                c["composite_score"] = c["route_quality"] * 0.75 + logp_score * 0.25
   290	
   291	        # 按复合评分排序（越高越好）
   292	        scored_candidates.sort(key=lambda x: x.get("composite_score", 0), reverse=True)
   293	        log(f"复合评分排序完成 (0.75×BE + 0.15×路线质量 + 0.10×LogP)", log_lines)
   294	
   295	    # 选择 top N
   296	    final_top = scored_candidates[:n_top]
   297	    results = []
   298	    trivial_count = 0
   299	    for c in final_top:
