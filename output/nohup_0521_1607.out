   687	                    full_parts.append(sub["route"])
   688	            full_parts.append(result["route"])
   689	            full_route = " | ".join(full_parts)
   690	
   691	            total_steps = result["steps"] + sum(s.get("steps", 0) for s in sub_routes)
   692	            is_trivial = all_trivial and len(reactants) == 1 and reactants[0] == smiles
