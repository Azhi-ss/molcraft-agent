   115	def load_program() -> str:
   116	    """读取 program.md，这是人类与 Agent 交互的唯一接口。"""
   117	    if not PROGRAM_MD.exists():
   118	        raise FileNotFoundError(
   119	            f"{PROGRAM_MD} 不存在。这是 Agent 的指令书，必须创建后才能运行。"
   120	        )
   121	    return PROGRAM_MD.read_text(encoding="utf-8")
