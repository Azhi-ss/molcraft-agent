   156	def count_iterations() -> int:
   157	    """统计 Agent 已报告的迭代次数。
   158	
   159	    Agent 每完成一轮「文献→诊断→改代码→实验验证」闭环后，
   160	    会主动调用 report_iteration 工具，写入一条记录到 docs/iteration_log.jsonl。
   161	    """
   162	    if not ITERATION_LOG.exists():
   163	        return 0
   164	    count = 0
   165	    try:
   166	        with open(ITERATION_LOG, "r", encoding="utf-8") as f:
   167	            for line in f:
   168	                if line.strip():
   169	                    count += 1
   170	    except Exception:
   171	        pass
   172	    return count
   173	
