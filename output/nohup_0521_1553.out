   296	def _is_simple_molecule(smiles: str) -> bool:
   297	    """判断分子是否为足够简单的起始原料，无需继续逆合成。
   298	    
   299	    H015 修复: 不再将多环芳烃/联芳基误判为"简单"。
   300	    含苯环且 ≤15 原子的分子如果是单环则简单，多环则可能需要断键。
   301	    文献依据: LARC (2025) — 起始原料应为商业可得的单环简单分子。
   302	    """
   303	    mol = Chem.MolFromSmiles(smiles)
   304	    if mol is None:
   305	        return False
   306	    # 原子数 <= 10 视为简单
   307	    if mol.GetNumAtoms() <= 10:
   308	        return True
   309	    # 匹配常见简单骨架
   310	    for s in _SIMPLE_SCAFFOLDS_SMARTS:
   311	        patt = Chem.MolFromSmarts(s)
   312	        if patt and mol.HasSubstructMatch(patt):
   313	            # H015 修复: 只接受单环或几乎无取代的分子（≤12 原子）
   314	            # 排除多环芳烃（联苯、萘等）被误判为"简单"
   315	            n_atoms = mol.GetNumAtoms()
   316	            ring_info = mol.GetRingInfo()
   317	            n_rings = ring_info.NumRings()
   318	            # 单环 + ≤15 原子 → 简单
   319	            if n_rings == 1 and n_atoms <= 15:
   320	                return True
   321	            # 多环但很小（如萘本身只有 10 原子）→ 简单
   322	            if n_rings >= 2 and n_atoms <= 10:
   323	                return True
   324	    return False
