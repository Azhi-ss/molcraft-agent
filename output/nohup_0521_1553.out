   175	async def monitor(stop_event: asyncio.Event, max_iterations: int, max_seconds: float, initial_iteration_count: int):
   176	    """独立协程：每 30 秒检查迭代次数和时间限制。"""
   177	    start_time = time.time()
   178	    limit_printed = False
   179	
   180	    while not stop_event.is_set():
   181	        await asyncio.sleep(30)
   182	
   183	        elapsed = time.time() - start_time
   184	
   185	        # 时间上限
   186	        if elapsed > max_seconds:
   187	            print(
   188	                f"\n\n[{datetime.now().isoformat()}] 达到最大运行时间 "
   189	                f"({int(max_seconds // 60)} 分钟)，正在退出...",
   190	                flush=True,
   191	            )
   192	            stop_event.set()
   193	            return
   194	
   195	        # 迭代次数上限（基于本轮新增的迭代，而非累积）
   196	        if max_iterations > 0 and not limit_printed:
   197	            current = count_iterations()
   198	            per_run_count = current - initial_iteration_count
   199	            print(
   200	                f"\n[{datetime.now().isoformat()}] 迭代进度: {per_run_count}/{max_iterations} (初始: {initial_iteration_count})",
   201	                flush=True,
   202	            )
   203	            if per_run_count >= max_iterations:
   204	                print(
   205	                    f"\n[{datetime.now().isoformat()}] 已达到最大迭代次数 "
   206	                    f"({max_iterations} 次)，60 秒后退出...",
   207	                    flush=True,
   208	                )
   209	                limit_printed = True
   210	                await asyncio.sleep(60)
   211	                stop_event.set()
   212	                return
   213	
