   124	def zip_results(output_dir: Path) -> None:
   125	    """打包结果文件供平台提交。原子操作：先写临时文件，成功后替换。"""
   126	    result_csv = output_dir / "result.csv"
   127	    result_log = output_dir / "result.log"
   128	
   129	    # 使用唯一临时文件名，避免并发冲突
   130	    fd, temp_zip_str = tempfile.mkstemp(prefix="result.", suffix=".zip", dir=output_dir)
   131	    os.close(fd)
   132	    temp_zip = Path(temp_zip_str)
   133	
   134	    try:
   135	        with zipfile.ZipFile(temp_zip, "w", zipfile.ZIP_DEFLATED) as zf:
   136	            if result_csv.exists():
   137	                zf.write(result_csv, arcname="result.csv")
   138	            if result_log.exists():
   139	                zf.write(result_log, arcname="result.log")
   140	
   141	        # 验证创建的 zip 文件有效
   142	        with zipfile.ZipFile(temp_zip, "r") as zf:
   143	            files = zf.namelist()
   144	            if "result.csv" not in files or "result.log" not in files:
   145	                raise RuntimeError(f"Zip missing required files: {files}")
   146	
   147	        # 原子替换
   148	        os.replace(str(temp_zip), str(output_dir / "result.zip"))
   149	        print(f"\n[打包完成] {output_dir / 'result.zip'}")
   150	    except Exception as e:
   151	        if temp_zip.exists():
   152	            temp_zip.unlink(missing_ok=True)
   153	        raise RuntimeError(f"打包失败: {e}") from e
   154	
