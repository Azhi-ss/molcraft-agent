    69	def _parse_int_env(name: str, default: int) -> int:
    70	    value = os.getenv(name)
    71	    if not value:
    72	        return default
    73	    try:
    74	        return int(value)
    75	    except ValueError:
    76	        return default
    77	
    78	
    79	def build_agent_llm_config() -> tuple[Config | None, str | None]:
    80	    """Build an explicit SDK config from LLM_* env vars when provided.
    81	
    82	    kimi_agent_sdk treats ``model=`` as a config model key, not a raw provider
    83	    model name. Supplying an in-memory config keeps LLM_MODEL tied to the
    84	    requested OpenAI-compatible provider instead of falling back to Kimi config.
    85	    """
    86	    base_url = os.getenv("LLM_BASE_URL")
    87	    api_key = os.getenv("LLM_API_KEY")
    88	    if not base_url or not api_key:
    89	        return None, None
    90	
    91	    model_name = os.getenv("LLM_MODEL", "deepseek-chat")
    92	    provider_type = os.getenv("LLM_PROVIDER_TYPE", "openai_legacy")
    93	    max_context_size = _parse_int_env("LLM_MAX_CONTEXT_SIZE", 100_000)
    94	
    95	    config = Config(
    96	        default_model=CUSTOM_LLM_MODEL_KEY,
    97	        models={
    98	            CUSTOM_LLM_MODEL_KEY: LLMModel(
    99	                provider=CUSTOM_LLM_PROVIDER_KEY,
   100	                model=model_name,
   101	                max_context_size=max_context_size,
   102	            )
   103	        },
   104	        providers={
   105	            CUSTOM_LLM_PROVIDER_KEY: LLMProvider(
   106	                type=provider_type,  # type: ignore[arg-type]
   107	                base_url=base_url,
   108	                api_key=SecretStr(api_key),
   109	            )
   110	        },
   111	    )
   112	    return config, CUSTOM_LLM_MODEL_KEY
   113	
